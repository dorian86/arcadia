<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Arcadia</AssemblyName>
    <RootNamespace>Arcadia</RootNamespace>
    <ApplicationIcon>Assets\Arcadia.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <!-- Public GitHub repository that holds the published versions (Releases with Arcadia.exe attached).
         The code itself can stay in a private repository. Format: pseudo/arcadia-releases -->
    <UpdateRepository>dorian86/arcadia-releases</UpdateRepository>
    <Product>Arcadia</Product>
    <Company>Arcadia</Company>
    <Description>Arcadia - lanceur de jeux PC</Description>
    <Copyright>© 2026 Arcadia</Copyright>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);MVVMTK0045;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Arcadia.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Arcadia.Tests" />
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
    <Using Include="System.Net.Http" />
    <Using Include="System.IO" />
    <!-- WinForms is only used for the tray icon: keep WPF types unambiguous -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>

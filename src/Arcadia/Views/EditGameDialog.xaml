<UserControl x:Class="Arcadia.Views.EditGameDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Arcadia.Controls"
             xmlns:m="clr-namespace:Arcadia.Models">
    <Border Style="{StaticResource DialogCard}" Width="860" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="30,26,22,0">
                <StackPanel>
                    <TextBlock Text="Modifier le jeu" Style="{StaticResource SectionTitle}" FontSize="22"/>
                    <TextBlock Text="Les fichiers du jeu ne sont jamais modifiés : seules les informations d'Arcadia sont mises à jour."
                               FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" c:Ui.Glyph="&#xE8BB;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding CancelCommand}" ToolTip="Fermer (Échap)"/>
            </Grid>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Auto" c:SmoothScroll.IsEnabled="True" Margin="0,22,0,0">
                <Grid Margin="30,0,30,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cover -->
                    <StackPanel>
                        <c:ClipBorder CornerRadius="14" Background="{Binding Game.Name, Converter={StaticResource NameToBrush}}">
                            <c:AspectRatioBox Ratio="1.5">
                                <Grid>
                                    <Image Width="72" Height="72" c:ImageLoader.Source="{Binding Game.IconFullPath}" c:ImageLoader.DecodeWidth="96"/>
                                    <Image Stretch="UniformToFill" c:ImageLoader.Source="{Binding CoverPreview}" c:ImageLoader.DecodeWidth="320"/>
                                    <Border CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource HairlineLight}"/>
                                </Grid>
                            </c:AspectRatioBox>
                        </c:ClipBorder>
                        <Button Style="{StaticResource SecondaryButton}" Content="Importer une image…" c:Ui.Glyph="&#xE8B5;" Margin="0,14,0,0"
                                HorizontalContentAlignment="Center" Command="{Binding ImportCoverCommand}"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Rechercher en ligne…" c:Ui.Glyph="&#xE721;" Margin="0,8,0,0"
                                HorizontalContentAlignment="Center" Command="{Binding SearchCoverCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Content="Réinitialiser" c:Ui.Glyph="&#xE72C;" Margin="0,4,0,0" Height="36" FontSize="13"
                                HorizontalContentAlignment="Center" Command="{Binding ResetCoverCommand}"
                                ToolTip="Supprime l'image actuelle et relance la recherche automatique"/>
                    </StackPanel>

                    <!-- Fields -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Nom du jeu" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="15"/>

                        <TextBlock Text="Fichier de lancement" Style="{StaticResource FieldLabel}" Margin="2,18,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding LaunchTarget, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12.5" c:Ui.Placeholder="C:\Jeux\MonJeu\jeu.exe ou steam://rungameid/…"/>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Parcourir…" Margin="8,0,0,0" Command="{Binding BrowseTargetCommand}"/>
                        </Grid>

                        <Grid Margin="0,18,0,0" Visibility="{Binding IsUrl, Converter={StaticResource InvBoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Arguments (facultatif)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="12.5" c:Ui.Placeholder="-fullscreen"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Dossier de travail (facultatif)" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Mono, Consolas" FontSize="12.5"/>
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" c:Ui.Glyph="&#xE8B7;" Margin="6,0,0,0"
                                            Background="{StaticResource Surface2}" Command="{Binding BrowseWorkingDirectoryCommand}" ToolTip="Choisir un dossier"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Développeur" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding Developer, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Éditeur" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Année" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding ReleaseYear, UpdateSourceTrigger=PropertyChanged}" MaxLength="4"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Genres" Style="{StaticResource FieldLabel}" Margin="2,18,0,7"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding Genres, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Action, Aventure…"/>

                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}" Margin="2,18,0,7"/>
                        <TextBox Style="{StaticResource MultiLineInputBox}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MinHeight="110" MaxHeight="180"/>

                        <!-- Launch options -->
                        <Border Height="1" Background="{StaticResource Stroke}" Margin="0,24,0,18"/>
                        <TextBlock Text="Options de lancement" Style="{StaticResource SectionTitle}" FontSize="16"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RunAsAdmin}" Margin="0,14,0,0" IsEnabled="{Binding IsUrl, Converter={StaticResource InvertBool}}">
                            <StackPanel>
                                <TextBlock Text="Exécuter en tant qu'administrateur" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Windows demandera une confirmation à chaque lancement." FontSize="12" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="Fenêtre d'Arcadia au lancement" Style="{StaticResource FieldLabel}" Margin="2,18,0,8"/>
                        <WrapPanel>
                            <Button Style="{StaticResource StatusPill}" Content="Réglage général" c:Ui.Glyph="&#xE713;" Foreground="{StaticResource TextPrimary}"
                                    c:Ui.IsActive="{Binding WindowOnLaunch, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static m:WindowOnLaunch.Default}, Mode=OneWay}"
                                    Command="{Binding SetWindowOnLaunchCommand}" CommandParameter="Default"/>
                            <Button Style="{StaticResource StatusPill}" Content="Réduire" c:Ui.Glyph="&#xE921;" Foreground="{StaticResource TextPrimary}"
                                    c:Ui.IsActive="{Binding WindowOnLaunch, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static m:WindowOnLaunch.Minimize}, Mode=OneWay}"
                                    Command="{Binding SetWindowOnLaunchCommand}" CommandParameter="Minimize"/>
                            <Button Style="{StaticResource StatusPill}" Content="Laisser ouverte" c:Ui.Glyph="&#xE7F4;" Foreground="{StaticResource TextPrimary}"
                                    c:Ui.IsActive="{Binding WindowOnLaunch, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static m:WindowOnLaunch.KeepOpen}, Mode=OneWay}"
                                    Command="{Binding SetWindowOnLaunchCommand}" CommandParameter="KeepOpen"/>
                            <Button Style="{StaticResource StatusPill}" Content="Fermer Arcadia" c:Ui.Glyph="&#xE8BB;" Foreground="{StaticResource TextPrimary}"
                                    c:Ui.IsActive="{Binding WindowOnLaunch, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static m:WindowOnLaunch.Close}, Mode=OneWay}"
                                    Command="{Binding SetWindowOnLaunchCommand}" CommandParameter="Close"
                                    ToolTip="Libère toute la mémoire pendant la partie (le temps de jeu n'est alors pas mesuré par Arcadia)"/>
                        </WrapPanel>
                        <TextBlock Text="Commande avant le lancement (facultatif)" Style="{StaticResource FieldLabel}" Margin="2,12,0,7"/>
                        <TextBox Style="{StaticResource InputBox}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Text="{Binding PreLaunchCommand, UpdateSourceTrigger=PropertyChanged}"
                                 c:Ui.Placeholder="ex. start C:\Outils\MSIAfterburner.exe"/>
                        <TextBlock Text="Commande après la fermeture du jeu (facultatif)" Style="{StaticResource FieldLabel}" Margin="2,14,0,7"/>
                        <TextBox Style="{StaticResource InputBox}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Text="{Binding PostExitCommand, UpdateSourceTrigger=PropertyChanged}"
                                 c:Ui.Placeholder="ex. taskkill /im MSIAfterburner.exe"/>
                        <TextBlock Text="Exécutées par l'invite de commandes, dans le dossier du jeu. La commande « après » nécessite qu'Arcadia ait pu suivre la partie."
                                   FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="2,8,0,0"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="30,16" CornerRadius="0,0,18,18"
                    Background="{StaticResource Bg1}">
                <Grid>
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" Margin="0,0,260,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Content="Annuler" Command="{Binding CancelCommand}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Enregistrer" c:Ui.Glyph="&#xE74E;" Margin="10,0,0,0"
                                Command="{Binding SaveCommand}" IsDefault="True"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

<sh:ConsoleShell x:Class="Arcadia.Views.Shells.Ps3Shell"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:c="clr-namespace:Arcadia.Controls"
                 xmlns:sh="clr-namespace:Arcadia.Views.Shells"
                 FontFamily="Segoe UI" TextOptions.TextFormattingMode="Ideal">
    <Grid ClipToBounds="True">
        <!-- background colour (changes with the month, set in code) -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush x:Name="BgBrush" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="BgTop" Color="#2462AE" Offset="0"/>
                    <GradientStop x:Name="BgMid" Color="#123A72" Offset="0.55"/>
                    <GradientStop Color="#050B18" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- selected game's artwork, very faint -->
        <Border x:Name="GameBg" Opacity="0" c:ImageLoader.Fade="False" RenderOptions.BitmapScalingMode="Linear"/>
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#00000000" Offset="0.4"/>
                    <GradientStop Color="#99000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <c:DesignScaler>
            <Grid>
                <!-- the wave: wide ribbons slowly drifting (cached, only translated) -->
                <Canvas x:Name="Wave" IsHitTestVisible="False" VerticalAlignment="Top" Margin="0,520,0,0" Height="260">
                    <Canvas.CacheMode><BitmapCache/></Canvas.CacheMode>
                    <Canvas.RenderTransform><TranslateTransform/></Canvas.RenderTransform>
                    <Path StrokeThickness="0" Opacity="0.22"
                          Data="M 0,120 C 400,10 800,240 1200,110 C 1600,-10 2000,230 2400,110 C 2800,0 3200,230 3600,120 L 3600,170 C 3200,280 2800,60 2400,160 C 2000,270 1600,40 1200,160 C 800,280 400,60 0,170 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Path Stroke="#B3FFFFFF" StrokeThickness="2.2"
                          Data="M 0,120 C 400,10 800,240 1200,110 C 1600,-10 2000,230 2400,110 C 2800,0 3200,230 3600,120"/>
                    <Path Stroke="#59FFFFFF" StrokeThickness="1.4"
                          Data="M 0,150 C 420,60 780,250 1200,140 C 1620,30 1980,250 2400,140 C 2820,50 3180,250 3600,150"/>
                    <Path Stroke="#33FFFFFF" StrokeThickness="1"
                          Data="M 0,95 C 380,20 820,200 1200,90 C 1580,-20 2020,200 2400,90 C 2780,10 3220,200 3600,95"/>
                </Canvas>

                <!-- clock -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,56,190,0">
                    <TextBlock x:Name="ClockDate" FontSize="24" FontWeight="Light" Foreground="#E6FFFFFF"/>
                    <TextBlock Text="{Binding TimeText}" FontSize="24" FontWeight="Light" Foreground="White" Margin="14,0,0,0"/>
                </StackPanel>

                <!-- items of the selected category (placed in code) -->
                <Canvas x:Name="Items"/>

                <!-- category bar -->
                <Canvas x:Name="CategoryBar" Margin="0,190,0,0" Height="150" VerticalAlignment="Top">
                    <StackPanel x:Name="CategoryRow" Orientation="Horizontal">
                        <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                    </StackPanel>
                </Canvas>

                <!-- clickable hints -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,60,20">
                    <Button Style="{StaticResource HintButton}" sh:ConsoleShell.Pad="A"><TextBlock Text="Ⓐ  Lancer" FontSize="17" Foreground="#CCFFFFFF"/></Button>
                    <Button Style="{StaticResource HintButton}" sh:ConsoleShell.Pad="Y" ToolTip="Options du jeu (F, ou clic droit pour le menu complet)"><TextBlock Text="ⓨ  Options" FontSize="17" Foreground="#CCFFFFFF"/></Button>
                    <Button Style="{StaticResource HintButton}" sh:ConsoleShell.Pad="X"><TextBlock Text="ⓧ  Au hasard" FontSize="17" Foreground="#CCFFFFFF"/></Button>
                </StackPanel>

                <!-- a click outside the options panel closes it -->
                <Border x:Name="OptionsShield" Background="Transparent" Visibility="Collapsed" MouseLeftButtonDown="OptionsShield_MouseDown"/>

                <!-- options panel ("triangle") -->
                <Grid x:Name="Options" Width="430" HorizontalAlignment="Right" Visibility="Collapsed">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#D9000000" Offset="0.12"/>
                                <GradientStop Color="#F2000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Width="2" HorizontalAlignment="Left" Margin="50,0,0,0" Fill="#40FFFFFF"/>
                    <StackPanel x:Name="OptionList" VerticalAlignment="Center" Margin="90,0,30,0"/>
                </Grid>

            </Grid>
        </c:DesignScaler>
    </Grid>
</sh:ConsoleShell>

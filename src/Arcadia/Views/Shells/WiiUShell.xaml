<sh:ConsoleShell x:Class="Arcadia.Views.Shells.WiiUShell"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:c="clr-namespace:Arcadia.Controls"
                 xmlns:sh="clr-namespace:Arcadia.Views.Shells"
                 FontFamily="Segoe UI" TextOptions.TextFormattingMode="Ideal">
    <sh:ConsoleShell.Resources>
        <!-- Square icon with a white frame; the selected one gets a pulsing blue outline (code) -->
        <Style x:Key="Icon" TargetType="Button" BasedOn="{StaticResource BareButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="16" Background="#1F2D3A4A" Margin="3,7,-3,-7"/>
                            <Border x:Name="Pulse" CornerRadius="22" Margin="-9" BorderThickness="6" BorderBrush="#12B5F0" Opacity="0"/>
                            <Border CornerRadius="16" Background="White" Padding="5">
                                <Grid>
                                    <Border CornerRadius="12" Background="#E3E7EB"/>
                                    <Grid x:Name="Art">
                                        <Border CornerRadius="12" Background="{Binding Name, Converter={StaticResource NameToBrush}}"/>
                                        <Border CornerRadius="12" c:ImageLoader.Source="{Binding SquareTilePath}" c:ImageLoader.DecodeWidth="240"/>
                                    </Grid>
                                    <TextBlock x:Name="Plus" Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="30" Foreground="#B6BEC6" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter TargetName="Art" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Plus" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round app buttons of the top row -->
        <Style x:Key="AppButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
            <Setter Property="Margin" Value="0,0,26,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Background="Transparent">
                            <Grid Width="72" Height="72">
                                <Ellipse Fill="#1F2D3A4A" Margin="2,5,-2,-5"/>
                                <Ellipse x:Name="Disc" Fill="White" Stroke="#D3D8DD" StrokeThickness="2"/>
                                <Ellipse Margin="9" Fill="{TemplateBinding Background}"/>
                                <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource Glyph}" FontSize="24" Foreground="White"/>
                            </Grid>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Tag}" FontSize="15" Foreground="#7A838C" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Stroke" Value="#12B5F0"/>
                                <Setter TargetName="Disc" Property="StrokeThickness" Value="4"/>
                                <Setter TargetName="Label" Property="Foreground" Value="#2C3540"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </sh:ConsoleShell.Resources>

    <Grid ClipToBounds="True">
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FBFCFD" Offset="0"/>
                    <GradientStop Color="#E8ECF0" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Fill="{StaticResource DotGridBrush}"/>

        <c:DesignScaler>
            <Grid>
                <!-- top row: user, apps, clock -->
                <StackPanel Orientation="Horizontal" Margin="60,30,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid Width="72" Height="72">
                        <Ellipse Fill="#1F2D3A4A" Margin="2,5,-2,-5"/>
                        <Ellipse Fill="White" Stroke="#D3D8DD" StrokeThickness="2"/>
                        <Ellipse Margin="7">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFCB6B" Offset="0"/>
                                    <GradientStop Color="#F59B2E" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding UserInitial}" FontSize="30" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding UserName}" FontSize="22" Foreground="#58616A" VerticalAlignment="Center" Margin="16,0,46,18"/>
                    <Button Style="{StaticResource AppButton}" Content="&#xE713;" Tag="Réglages" Background="#8A96A3" Command="{Binding OpenSettingsCommand}"/>
                    <Button Style="{StaticResource AppButton}" Content="&#xE790;" Tag="Thèmes" Background="#12B5F0" Command="{Binding Main.OpenThemesCommand}"/>
                    <Button x:Name="AddButton" Style="{StaticResource AppButton}" Content="&#xE710;" Tag="Ajouter" Background="#5CC15A" Click="Add_Click"/>
                    <Button Style="{StaticResource AppButton}" Content="&#xE8B1;" Tag="Au hasard" Background="#F28C28" Command="{Binding RandomCommand}"/>
                    <Button Style="{StaticResource AppButton}" Content="&#xE8A9;" Tag="Classique" Background="#9B7BD0" Command="{Binding OpenClassicCommand}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,190,0">
                    <TextBlock Text="{Binding TimeText}" FontSize="40" FontWeight="Light" Foreground="#58616A" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding DateText}" FontSize="16" Foreground="#8A939C" HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- banner of the selected game -->
                <Grid x:Name="Banner" Margin="60,148,60,0" Height="300" VerticalAlignment="Top">
                    <Border CornerRadius="26" Background="#1F2D3A4A" Margin="4,9,-4,-9"/>
                    <Border CornerRadius="26" Background="White" Padding="7">
                        <Grid>
                            <Border CornerRadius="20" Background="{Binding Current.Name, Converter={StaticResource NameToBrush}}"/>
                            <!-- wide illustration, or (without one) the whole cover on the right over a blurred copy -->
                            <Border CornerRadius="20" c:ImageLoader.Source="{Binding Current.HeroFullPath}" c:ImageLoader.DecodeWidth="1500"
                                    Visibility="{Binding Current.HasHero, Converter={StaticResource BoolToVis}}"/>
                            <Grid Visibility="{Binding Current.HasHero, Converter={StaticResource InvBoolToVis}}">
                                <Border CornerRadius="20" c:ImageLoader.Source="{Binding Current.CoverFullPath}" c:ImageLoader.DecodeWidth="24" Opacity="0.85"
                                        RenderOptions.BitmapScalingMode="Linear"/>
                                <Border CornerRadius="20" Background="#4D0B1A2A"/>
                                <Image c:ImageLoader.Source="{Binding Current.CoverFullPath}" c:ImageLoader.DecodeWidth="400" Stretch="Uniform"
                                       HorizontalAlignment="Right" Margin="0,16,70,16"/>
                            </Grid>
                            <Border CornerRadius="20">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#CC0B1A2A" Offset="0"/>
                                        <GradientStop Color="#550B1A2A" Offset="0.5"/>
                                        <GradientStop Color="#000B1A2A" Offset="0.8"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel Margin="46,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="700">
                                <Image c:ImageLoader.Source="{Binding Current.LogoFullPath}" c:ImageLoader.DecodeWidth="600" MaxHeight="120" MaxWidth="460"
                                       HorizontalAlignment="Left" Visibility="{Binding Current.HasLogo, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding Current.Name}" FontSize="40" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Current.HasLogo, Converter={StaticResource InvBoolToVis}}"/>
                                <TextBlock x:Name="BannerInfo" FontSize="19" Foreground="#E6FFFFFF" Margin="2,14,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                    <Button Style="{StaticResource BareButton}" Command="{Binding PlayCommand}">
                                        <Border CornerRadius="30" Height="60" Padding="40,0" Background="White">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="20" Foreground="#12A6DF"/>
                                                <TextBlock Text="Lancer" FontSize="24" FontWeight="SemiBold" Foreground="#12A6DF" Margin="12,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                    <Button Style="{StaticResource BareButton}" Margin="14,0,0,0" Command="{Binding OpenDetailsCommand}" ToolTip="Fiche du jeu">
                                        <Border CornerRadius="30" Width="60" Height="60" Background="#40FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="2">
                                            <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="20" Foreground="White"/>
                                        </Border>
                                    </Button>
                                    <Button Style="{StaticResource BareButton}" Margin="12,0,0,0" Command="{Binding ToggleFavoriteCommand}" ToolTip="Favori (F)">
                                        <Border CornerRadius="30" Width="60" Height="60" Background="#40FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="2">
                                            <TextBlock x:Name="FavGlyph" Text="&#xEB51;" Style="{StaticResource Glyph}" FontSize="20" Foreground="White"/>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- icon grid -->
                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,486,0,0">
                    <UniformGrid x:Name="IconGrid" Rows="2" Columns="7" Width="1330" Height="380">
                        <UniformGrid.RenderTransform><TranslateTransform/></UniformGrid.RenderTransform>
                    </UniformGrid>
                </Grid>
                <Button x:Name="PrevPage" Style="{StaticResource BareButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="38,640,0,0" Click="PrevPage_Click">
                    <Grid Width="46" Height="84">
                        <Border CornerRadius="23" Background="White" BorderBrush="#D3D8DD" BorderThickness="2"/>
                        <TextBlock Text="&#xE76B;" Style="{StaticResource Glyph}" FontSize="20" Foreground="#12B5F0"/>
                    </Grid>
                </Button>
                <Button x:Name="NextPage" Style="{StaticResource BareButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,640,38,0" Click="NextPage_Click">
                    <Grid Width="46" Height="84">
                        <Border CornerRadius="23" Background="White" BorderBrush="#D3D8DD" BorderThickness="2"/>
                        <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="20" Foreground="#12B5F0"/>
                    </Grid>
                </Button>
                <ItemsControl x:Name="PageDots" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="58,0,0,8">
                    <Button Style="{StaticResource HintButton}" sh:ConsoleShell.Pad="LB" ToolTip="Liste précédente">
                        <TextBlock Text="&#xE76B;" Style="{StaticResource Glyph}" FontSize="14" Foreground="#12A6DF"/>
                    </Button>
                    <TextBlock x:Name="CategoryText" FontSize="18" Foreground="#6E7780" VerticalAlignment="Center" Margin="4,0"/>
                    <Button Style="{StaticResource HintButton}" sh:ConsoleShell.Pad="RB" ToolTip="Liste suivante">
                        <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="14" Foreground="#12A6DF"/>
                    </Button>
                </StackPanel>
            </Grid>
        </c:DesignScaler>
    </Grid>
</sh:ConsoleShell>

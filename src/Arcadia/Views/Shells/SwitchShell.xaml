<sh:ConsoleShell x:Class="Arcadia.Views.Shells.SwitchShell"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:c="clr-namespace:Arcadia.Controls"
                 xmlns:sh="clr-namespace:Arcadia.Views.Shells"
                 FontFamily="Segoe UI" TextOptions.TextFormattingMode="Ideal">
    <sh:ConsoleShell.Resources>
        <!-- palette, replaced in code for the light variant -->
        <SolidColorBrush x:Key="SwBg" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="SwText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SwMuted" Color="#A8A8A8"/>
        <SolidColorBrush x:Key="SwLine" Color="#5A5A5A"/>
        <SolidColorBrush x:Key="SwTile" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="SwSelect" Color="#00C3E3"/>
        <SolidColorBrush x:Key="SwDisc" Color="#464646"/>

        <!-- Square software tile -->
        <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource BareButton}">
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="300"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Frame" Margin="-11" BorderThickness="5" BorderBrush="{DynamicResource SwSelect}" Opacity="0">
                                <Border Margin="0" BorderThickness="3" BorderBrush="{DynamicResource SwBg}"/>
                            </Border>
                            <Border Background="{Binding Name, Converter={StaticResource NameToBrush}}"/>
                            <Border c:ImageLoader.Source="{Binding SquareTilePath}" c:ImageLoader.DecodeWidth="420"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round shortcut buttons -->
        <Style x:Key="Disc" TargetType="Button" BasedOn="{StaticResource BareButton}">
            <Setter Property="Margin" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="104" Height="104" Background="Transparent">
                            <Ellipse x:Name="Ring" Margin="-9" StrokeThickness="5" Stroke="{DynamicResource SwSelect}" Opacity="0"/>
                            <Ellipse Fill="{DynamicResource SwDisc}"/>
                            <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource Glyph}" FontSize="36" Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="focus">
                                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small square of the "Tous les logiciels" grid -->
        <Style x:Key="GridTile" TargetType="Button" BasedOn="{StaticResource BareButton}">
            <Setter Property="Width" Value="196"/>
            <Setter Property="Height" Value="196"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Frame" Margin="-9" BorderThickness="5" BorderBrush="{DynamicResource SwSelect}" Opacity="0"/>
                            <Border Background="{Binding Name, Converter={StaticResource NameToBrush}}"/>
                            <Border c:ImageLoader.Source="{Binding SquareTilePath}" c:ImageLoader.DecodeWidth="280"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </sh:ConsoleShell.Resources>

    <Grid ClipToBounds="True" Background="{DynamicResource SwBg}">
        <c:DesignScaler>
            <Grid>
                <!-- top bar -->
                <Grid VerticalAlignment="Top" Height="140">
                    <StackPanel Orientation="Horizontal" Margin="78,44,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Grid Width="76" Height="76">
                            <Ellipse>
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFB547" Offset="0"/>
                                        <GradientStop Color="#F0722B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding UserInitial}" FontSize="34" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,62,200,0">
                        <TextBlock Text="{Binding TimeText}" FontSize="26" Foreground="{DynamicResource SwText}" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE701;" Style="{StaticResource Glyph}" FontSize="24" Foreground="{DynamicResource SwText}" Margin="26,0,0,0"/>
                        <StackPanel x:Name="Battery" Orientation="Horizontal" Margin="22,0,0,0" Visibility="{Binding BatteryText, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding BatteryText}" FontSize="22" Foreground="{DynamicResource SwText}" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE83F;" Style="{StaticResource Glyph}" FontSize="24" Foreground="{DynamicResource SwText}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ============================ Home ============================ -->
                <Grid x:Name="HomeLayer">
                    <TextBlock x:Name="SelectedTitle" FontSize="28" Foreground="{DynamicResource SwSelect}" VerticalAlignment="Top" HorizontalAlignment="Left"
                               Margin="96,186,0,0" TextTrimming="CharacterEllipsis" MaxWidth="900"/>
                    <Canvas Margin="0,236,0,0" Height="320" VerticalAlignment="Top" ClipToBounds="False">
                        <StackPanel x:Name="Strip" Orientation="Horizontal" Canvas.Left="96" Canvas.Top="10">
                            <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                        </StackPanel>
                    </Canvas>

                    <StackPanel x:Name="Discs" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,610,0,0">
                        <Button Style="{StaticResource Disc}" Content="&#xEB52;" Foreground="#FF4B5B" ToolTip="Favoris" Tag="" Click="Favorites_Click"/>
                        <Button Style="{StaticResource Disc}" Content="&#xE8B1;" Foreground="#FF9F2E" ToolTip="Au hasard" Command="{Binding RandomCommand}"/>
                        <Button Style="{StaticResource Disc}" Content="&#xE790;" Foreground="#3EA6FF" ToolTip="Thèmes" Command="{Binding Main.OpenThemesCommand}"/>
                        <Button x:Name="AddDisc" Style="{StaticResource Disc}" Content="&#xE710;" Foreground="#4CD964" ToolTip="Ajouter des jeux" Click="Add_Click"/>
                        <Button Style="{StaticResource Disc}" Content="&#xE8A9;" Foreground="{DynamicResource SwText}" ToolTip="Interface classique" Command="{Binding OpenClassicCommand}"/>
                        <Button Style="{StaticResource Disc}" Content="&#xE7F4;" Foreground="{DynamicResource SwText}" ToolTip="Mode TV" Command="{Binding Main.EnterTvModeCommand}"/>
                        <Button Style="{StaticResource Disc}" Content="&#xE713;" Foreground="{DynamicResource SwText}" ToolTip="Réglages" Command="{Binding OpenSettingsCommand}"/>
                    </StackPanel>
                    <TextBlock x:Name="DiscLabel" FontSize="22" Foreground="{DynamicResource SwSelect}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,740,0,0"/>
                </Grid>

                <!-- ============================ All software ============================ -->
                <Grid x:Name="GridLayer" Visibility="Collapsed" Background="{DynamicResource SwBg}">
                    <StackPanel Orientation="Horizontal" Margin="70,142,0,0" VerticalAlignment="Top">
                        <Button Style="{StaticResource HintButton}" sh:ConsoleShell.Pad="B" ToolTip="Retour (B, Échap ou bouton précédent de la souris)" Padding="12,8">
                            <TextBlock Text="&#xE72B;" Style="{StaticResource Glyph}" FontSize="26" Foreground="{DynamicResource SwText}"/>
                        </Button>
                        <TextBlock x:Name="GridTitle" FontSize="34" Foreground="{DynamicResource SwText}" Margin="14,0,26,0" VerticalAlignment="Center"/>
                        <Button x:Name="GridPrev" Style="{StaticResource HintButton}" sh:ConsoleShell.Pad="LB" ToolTip="Liste précédente" Padding="10,8">
                            <TextBlock Text="&#xE76B;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{DynamicResource SwMuted}"/>
                        </Button>
                        <Button x:Name="GridNext" Style="{StaticResource HintButton}" sh:ConsoleShell.Pad="RB" ToolTip="Liste suivante" Padding="10,8">
                            <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{DynamicResource SwMuted}"/>
                        </Button>
                    </StackPanel>
                    <Rectangle Height="2" Fill="{DynamicResource SwLine}" VerticalAlignment="Top" Margin="70,212,70,0"/>
                    <ScrollViewer x:Name="GridScroll" Margin="70,222,70,110" VerticalScrollBarVisibility="Hidden" c:SmoothScroll.IsEnabled="True" Focusable="False">
                        <WrapPanel x:Name="GridPanel" Margin="0,16,0,16" Width="1320" HorizontalAlignment="Center"/>
                    </ScrollViewer>
                </Grid>

                <!-- bottom bar -->
                <Rectangle Height="2" Fill="{DynamicResource SwLine}" VerticalAlignment="Bottom" Margin="44,0,44,96"/>
                <TextBlock Text="&#xE7FC;" Style="{StaticResource Glyph}" FontSize="30" Foreground="{DynamicResource SwText}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="86,0,0,34"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,86,34">
                    <Button x:Name="HintB" Style="{StaticResource HintButton}" sh:ConsoleShell.Pad="B" Margin="0,0,16,0">
                        <TextBlock Text="Ⓑ  Retour" FontSize="22" Foreground="{DynamicResource SwText}"/>
                    </Button>
                    <Button Style="{StaticResource HintButton}" sh:ConsoleShell.Pad="A">
                        <TextBlock Text="Ⓐ  Lancer" FontSize="22" Foreground="{DynamicResource SwText}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </c:DesignScaler>
    </Grid>
</sh:ConsoleShell>

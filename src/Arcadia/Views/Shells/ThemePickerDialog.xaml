<UserControl x:Class="Arcadia.Views.Shells.ThemePickerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Arcadia.Controls"
             xmlns:sh="clr-namespace:Arcadia.Views.Shells"
             xmlns:vm="clr-namespace:Arcadia.ViewModels">
    <Border Style="{StaticResource DialogCard}" Width="940" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="30,26,22,0">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="48" Height="48">
                        <Ellipse Fill="{DynamicResource AccentGlow}" Margin="-14"/>
                        <Ellipse Fill="{DynamicResource AccentGradient}"/>
                        <TextBlock Text="&#xE790;" Style="{StaticResource Glyph}" FontSize="19" Foreground="White"/>
                    </Grid>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Thèmes" Style="{StaticResource SectionTitle}" FontSize="22"/>
                        <TextBlock Text="Changez toute l'interface : chaque thème reprend la disposition et l'ambiance du menu d'une console."
                                   FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" c:Ui.Glyph="&#xE8BB;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding CloseCommand}" ToolTip="Fermer (Échap)"/>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,22,0,0" MaxHeight="560" VerticalScrollBarVisibility="Auto" c:SmoothScroll.IsEnabled="True">
                <ItemsControl ItemsSource="{Binding Choices}" Margin="24,0,24,6" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ThemeChoice}">
                            <Button Style="{StaticResource BareButton}" Margin="6,0,6,18"
                                    Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <Grid>
                                        <Border x:Name="Ring" CornerRadius="13" Margin="-3" BorderThickness="2.5" BorderBrush="{DynamicResource AccentGradient}" Opacity="0"/>
                                        <Border x:Name="Frame" CornerRadius="11" BorderThickness="1" BorderBrush="{StaticResource Stroke}" Height="112">
                                            <Border CornerRadius="10" ClipToBounds="True">
                                                <Border.OpacityMask>
                                                    <VisualBrush>
                                                        <VisualBrush.Visual>
                                                            <Border Width="200" Height="112" CornerRadius="10" Background="Black"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Border.OpacityMask>
                                                <sh:ThemePreview Key="{Binding Theme.Key}"/>
                                            </Border>
                                        </Border>
                                        <Border CornerRadius="9" Background="{DynamicResource AccentGradient}" Padding="8,3" Margin="8"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="9" Foreground="White"/>
                                                <TextBlock Text="Actuel" FontSize="10.5" FontWeight="SemiBold" Foreground="White" Margin="5,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="Name" Text="{Binding Theme.Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="3,11,3,0"/>
                                    <TextBlock Text="{Binding Theme.Description}" FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                               Margin="3,3,3,0" Height="32"/>
                                </StackPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="0.7"/>
                                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="30,14,30,18" Margin="0,8,0,0">
                <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                           Text="Dans un thème : flèches ou manette pour naviguer, Entrée / A pour lancer, F / Y pour les favoris. La fiche d'un jeu et les réglages s'ouvrent dans l'interface Arcadia, avec un bouton pour revenir au thème. Les dessins et les sons des thèmes sont propres à Arcadia : aucun logo ni son officiel."/>
            </Border>
        </Grid>
    </Border>
</UserControl>

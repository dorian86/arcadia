<sh:ConsoleShell x:Class="Arcadia.Views.Shells.Ps4Shell"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:c="clr-namespace:Arcadia.Controls"
                 xmlns:sh="clr-namespace:Arcadia.Views.Shells"
                 FontFamily="Segoe UI" TextOptions.TextFormattingMode="Ideal">
    <sh:ConsoleShell.Resources>
        <Style x:Key="FnButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
            <Setter Property="Margin" Value="20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="64" Height="64" Background="Transparent">
                            <Border x:Name="Bg" CornerRadius="6" Background="#26FFFFFF" Opacity="0"/>
                            <Border x:Name="Ring" CornerRadius="7" BorderThickness="3" BorderBrush="White" Margin="-4" Opacity="0"/>
                            <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource Glyph}" FontSize="28" Foreground="White"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="focus">
                                <Setter TargetName="Bg" Property="Opacity" Value="1"/>
                                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </sh:ConsoleShell.Resources>

    <Grid ClipToBounds="True">
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1B6FC8" Offset="0"/>
                    <GradientStop Color="#0D3F86" Offset="0.5"/>
                    <GradientStop Color="#061E45" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- selected game's artwork in the upper part -->
        <Border x:Name="GameBg" Opacity="0" c:ImageLoader.Fade="False" c:ImageLoader.AlignY="Top" RenderOptions.BitmapScalingMode="Linear">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="0.75"/>
                </LinearGradientBrush>
            </Border.OpacityMask>
        </Border>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#330D3F86" Offset="0"/>
                    <GradientStop Color="#990D3F86" Offset="0.6"/>
                    <GradientStop Color="#E6061E45" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <c:DesignScaler>
            <Grid>
                <!-- soft light shapes drifting slowly (cached) -->
                <Canvas x:Name="Lights" IsHitTestVisible="False" Opacity="0.55">
                    <Canvas.CacheMode><BitmapCache/></Canvas.CacheMode>
                    <Canvas.RenderTransform><TranslateTransform/></Canvas.RenderTransform>
                    <Ellipse Canvas.Left="-200" Canvas.Top="560" Width="900" Height="340">
                        <Ellipse.Fill>
                            <RadialGradientBrush><GradientStop Color="#40A8D8FF" Offset="0"/><GradientStop Color="#00A8D8FF" Offset="1"/></RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="900" Canvas.Top="420" Width="1100" Height="420">
                        <Ellipse.Fill>
                            <RadialGradientBrush><GradientStop Color="#3070B8FF" Offset="0"/><GradientStop Color="#0070B8FF" Offset="1"/></RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Path Stroke="#30FFFFFF" StrokeThickness="2" Data="M -100,820 C 300,700 700,860 1100,740 C 1500,620 1800,780 2200,700"/>
                    <Path Stroke="#1EFFFFFF" StrokeThickness="18" Data="M -100,840 C 300,720 700,880 1100,760 C 1500,640 1800,800 2200,720"/>
                </Canvas>

                <!-- top: function row, user and clock -->
                <StackPanel x:Name="FnRow" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,44,0,0">
                    <Button Style="{StaticResource FnButton}" Content="&#xEB51;" ToolTip="Favoris" Click="Favorites_Click"/>
                    <Button Style="{StaticResource FnButton}" Content="&#xE8F1;" ToolTip="Bibliothèque" Click="Library_Click"/>
                    <Button Style="{StaticResource FnButton}" Content="&#xE8B1;" ToolTip="Au hasard" Command="{Binding RandomCommand}"/>
                    <Button x:Name="AddFn" Style="{StaticResource FnButton}" Content="&#xE710;" ToolTip="Ajouter des jeux" Click="Add_Click"/>
                    <Button Style="{StaticResource FnButton}" Content="&#xE790;" ToolTip="Thèmes" Command="{Binding Main.OpenThemesCommand}"/>
                    <Button Style="{StaticResource FnButton}" Content="&#xE7F4;" ToolTip="Mode TV" Command="{Binding Main.EnterTvModeCommand}"/>
                    <Button Style="{StaticResource FnButton}" Content="&#xE8A9;" ToolTip="Interface classique" Command="{Binding OpenClassicCommand}"/>
                    <Button Style="{StaticResource FnButton}" Content="&#xE713;" ToolTip="Réglages" Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>
                <TextBlock x:Name="FnLabel" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,118,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="70,52,0,0">
                    <Border Width="48" Height="48" CornerRadius="4" Background="#F28C28">
                        <TextBlock Text="{Binding UserInitial}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding UserName}" FontSize="20" Foreground="White" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding TimeText}" FontSize="24" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,190,0"/>

                <!-- content row -->
                <TextBlock x:Name="SelectedTitle" FontSize="30" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="430,226,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="1000"/>
                <Canvas Margin="0,280,0,0" VerticalAlignment="Top" Height="320">
                    <StackPanel x:Name="Row" Orientation="Horizontal" Canvas.Left="110">
                        <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                    </StackPanel>
                </Canvas>

                <!-- start button + information -->
                <Grid x:Name="InfoArea" Margin="110,612,110,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="StartButton" Style="{StaticResource BareButton}" Command="{Binding PlayCommand}" VerticalAlignment="Top">
                        <Grid Height="62">
                            <Border x:Name="StartBg" Background="#33FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="2"/>
                            <TextBlock Text="Commencer" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <UniformGrid Grid.Column="1" Columns="3" Margin="30,0,0,0" VerticalAlignment="Top">
                        <Border Background="#1FFFFFFF" Padding="22,14" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="Temps de jeu" FontSize="16" Foreground="#B3FFFFFF"/>
                                <TextBlock x:Name="InfoTime" FontSize="26" Foreground="White" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1FFFFFFF" Padding="22,14" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="Dernière partie" FontSize="16" Foreground="#B3FFFFFF"/>
                                <TextBlock x:Name="InfoLast" FontSize="26" Foreground="White" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1FFFFFFF" Padding="22,14">
                            <StackPanel>
                                <TextBlock Text="Plateforme" FontSize="16" Foreground="#B3FFFFFF"/>
                                <TextBlock x:Name="InfoPlatform" FontSize="26" Foreground="White" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock x:Name="InfoDesc" Grid.Column="1" FontSize="17" Foreground="#CCFFFFFF" TextWrapping="Wrap" TextTrimming="WordEllipsis"
                               MaxHeight="76" Margin="30,112,0,0" VerticalAlignment="Top"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="98,0,0,22">
                    <Button Style="{StaticResource HintButton}" sh:ConsoleShell.Pad="LB" ToolTip="Liste précédente">
                        <TextBlock Text="&#xE76B;" Style="{StaticResource Glyph}" FontSize="14" Foreground="#CCFFFFFF"/>
                    </Button>
                    <TextBlock x:Name="CategoryText" FontSize="18" Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="4,0"/>
                    <Button Style="{StaticResource HintButton}" sh:ConsoleShell.Pad="RB" ToolTip="Liste suivante">
                        <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="14" Foreground="#CCFFFFFF"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,98,22">
                    <Button Style="{StaticResource HintButton}" sh:ConsoleShell.Pad="A"><TextBlock Text="Ⓐ  Commencer" FontSize="17" Foreground="#CCFFFFFF"/></Button>
                    <Button Style="{StaticResource HintButton}" sh:ConsoleShell.Pad="Y"><TextBlock Text="ⓨ  Favori" FontSize="17" Foreground="#CCFFFFFF"/></Button>
                    <Button Style="{StaticResource HintButton}" sh:ConsoleShell.Pad="X"><TextBlock Text="ⓧ  Au hasard" FontSize="17" Foreground="#CCFFFFFF"/></Button>
                    <Button Style="{StaticResource HintButton}" sh:ConsoleShell.Pad="Start"><TextBlock Text="☰  Fiche du jeu" FontSize="17" Foreground="#CCFFFFFF"/></Button>
                </StackPanel>
            </Grid>
        </c:DesignScaler>
    </Grid>
</sh:ConsoleShell>

<sh:ConsoleShell x:Class="Arcadia.Views.Shells.WiiShell"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:c="clr-namespace:Arcadia.Controls"
                 xmlns:sh="clr-namespace:Arcadia.Views.Shells"
                 FontFamily="Segoe UI" TextOptions.TextFormattingMode="Ideal">
    <sh:ConsoleShell.Resources>
        <!-- A "channel": white rounded frame, artwork inside, glassy top -->
        <Style x:Key="Channel" TargetType="Button" BasedOn="{StaticResource BareButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Glow" CornerRadius="22" Margin="-9" BorderThickness="6" Opacity="0">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#7FDBFF" Offset="0"/>
                                        <GradientStop Color="#2FB5EA" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                            <Border CornerRadius="17" Background="#16000000" Margin="2,5,-2,-5"/>
                            <Border CornerRadius="16" BorderThickness="3" BorderBrush="#C2C8CF" Padding="5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E9ECEF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Border CornerRadius="11" Background="{StaticResource EmptySlotBrush}"/>
                                    <Grid x:Name="Art">
                                        <Border CornerRadius="11" Background="{Binding Name, Converter={StaticResource NameToBrush}}"/>
                                        <Border CornerRadius="11" c:ImageLoader.Source="{Binding WideTilePath}" c:ImageLoader.DecodeWidth="460"/>
                                        <Image c:ImageLoader.Source="{Binding LogoFullPath}" c:ImageLoader.DecodeWidth="360" Margin="34,26"
                                               Visibility="{Binding WideTileNeedsLogo, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                    <!-- glass -->
                                    <Border CornerRadius="11,11,40,40" Margin="0,0,0,80">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#40FFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="11" BorderThickness="1" BorderBrush="#26000000"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter TargetName="Art" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Big round button of the bottom bar -->
        <Style x:Key="RoundButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="#1A000000" Margin="3,7,-3,-7"/>
                            <Ellipse StrokeThickness="4" Stroke="#A9B1B9">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#DDE2E7" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse x:Name="Ring" Margin="9" StrokeThickness="3" Stroke="#8FD6F2"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#2FB5EA"/>
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Wide pill buttons of the channel screen ("Menu" / "Démarrer") -->
        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
            <Setter Property="Width" Value="330"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="Foreground" Value="#4B545D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="50" Background="#1A000000" Margin="2,7,-2,-7"/>
                            <Border x:Name="Bd" CornerRadius="50" BorderThickness="4" BorderBrush="#AEB6BE">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E1E6EA" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="Focus" CornerRadius="56" Margin="-8" BorderThickness="6" BorderBrush="#3CBCEE" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Focus" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="focus">
                                <Setter TargetName="Focus" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="110"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Path x:Name="P" Data="{TemplateBinding Content}" Fill="#6FCBEF" Stroke="White" StrokeThickness="5" StrokeLineJoin="Round"
                                  Stretch="Uniform" Width="44" Height="70"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="P" Property="Fill" Value="#25AEE6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </sh:ConsoleShell.Resources>

    <Grid ClipToBounds="True">
        <!-- Background: pale grey with fine lines -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F7F8F9" Offset="0"/>
                    <GradientStop Color="#E4E7EA" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Fill="{StaticResource ScanlineBrush}"/>

        <c:DesignScaler>
            <Grid>
                <!-- ============================ Channel menu ============================ -->
                <Grid x:Name="MenuLayer">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="262"/>
                    </Grid.RowDefinitions>

                    <!-- category switcher -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource BareButton}" Click="PrevCategory_Click" Padding="0">
                            <TextBlock Text="&#xE76B;" Style="{StaticResource Glyph}" FontSize="18" Foreground="#7F8891" Margin="10"/>
                        </Button>
                        <Border CornerRadius="18" Background="#E6FFFFFF" BorderBrush="#CDD3D8" BorderThickness="2" Padding="22,5" MinWidth="200">
                            <TextBlock x:Name="CategoryText" FontSize="22" Foreground="#5D666F" HorizontalAlignment="Center"/>
                        </Border>
                        <Button Style="{StaticResource BareButton}" Click="NextCategory_Click">
                            <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="18" Foreground="#7F8891" Margin="10"/>
                        </Button>
                    </StackPanel>

                    <!-- the 12 channels -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,84,0,0">
                        <UniformGrid x:Name="ChannelGrid" Rows="3" Columns="4" Width="1300" Height="540">
                            <UniformGrid.RenderTransform><TranslateTransform/></UniformGrid.RenderTransform>
                        </UniformGrid>
                    </Grid>

                    <Button x:Name="PrevPage" Style="{StaticResource ArrowButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="40,84,0,0"
                            Content="M 30,0 L 0,25 L 30,50 Z" Click="PrevPage_Click"/>
                    <Button x:Name="NextPage" Style="{StaticResource ArrowButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,84,40,0"
                            Content="M 0,0 L 30,25 L 0,50 Z" Click="NextPage_Click"/>

                    <!-- ============================ Bottom bar ============================ -->
                    <Grid Grid.Row="1">
                        <Path Stretch="Fill" StrokeThickness="0" Data="M 0,70 C 160,70 190,8 330,8 L 540,8 C 690,8 680,96 800,96 C 920,96 910,8 1060,8 L 1270,8 C 1410,8 1440,70 1600,70 L 1600,262 L 0,262 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F3F5F6" Offset="0"/>
                                    <GradientStop Color="#D2D8DD" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <Path Stretch="Fill" Height="96" VerticalAlignment="Top" Stroke="#5EC4EE" StrokeThickness="4"
                              Data="M 0,66 C 160,66 190,4 330,4 L 540,4 C 690,4 680,92 800,92 C 920,92 910,4 1060,4 L 1270,4 C 1410,4 1440,66 1600,66"/>

                        <!-- clock and date -->
                        <TextBlock Text="{Binding TimeText}" FontSize="62" FontWeight="Light" Foreground="#9AA2A9" HorizontalAlignment="Center"
                                   VerticalAlignment="Top" Margin="0,-6,0,0"/>
                        <TextBlock Text="{Binding ShortDateText}" FontSize="40" Foreground="#6E7780" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,118,0,0"/>

                        <!-- round buttons -->
                        <Button Style="{StaticResource RoundButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="96,46,0,0"
                                Command="{Binding OpenSettingsCommand}" ToolTip="Réglages d'Arcadia">
                            <StackPanel>
                                <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="34" Foreground="#5E676F"/>
                                <TextBlock Text="Arcadia" FontSize="22" FontWeight="SemiBold" Foreground="#5E676F" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RoundButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,46,96,0"
                                Command="{Binding Main.OpenThemesCommand}" ToolTip="Changer de thème">
                            <StackPanel>
                                <TextBlock Text="&#xE790;" Style="{StaticResource Glyph}" FontSize="34" Foreground="#5E676F"/>
                                <TextBlock Text="Thèmes" FontSize="22" FontWeight="SemiBold" Foreground="#5E676F" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="PageText" FontSize="20" Foreground="#8D959C" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="300,150,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,142,290,0">
                            <Button Style="{StaticResource HintButton}" sh:ConsoleShell.Pad="X" ToolTip="Choisir un jeu au hasard (R)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B1;" Style="{StaticResource Glyph}" FontSize="15" Foreground="#6E7780"/>
                                    <TextBlock Text="Au hasard" FontSize="18" Foreground="#6E7780" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="AddHint" Style="{StaticResource HintButton}" Click="AddHint_Click" ToolTip="Ajouter des jeux">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="15" Foreground="#6E7780"/>
                                    <TextBlock Text="Ajouter" FontSize="18" Foreground="#6E7780" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ============================ Channel screen ============================ -->
                <Grid x:Name="PreviewLayer" Visibility="Collapsed" Background="#F2F4F6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="270"/>
                    </Grid.RowDefinitions>
                    <Grid ClipToBounds="True" Background="{Binding Current.Name, Converter={StaticResource NameToBrush}}">
                        <Border x:Name="PreviewArt" c:ImageLoader.Source="{Binding Current.WideTilePath}" c:ImageLoader.DecodeWidth="1600"/>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.5"/>
                                    <GradientStop Color="#66000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Image c:ImageLoader.Source="{Binding Current.LogoFullPath}" c:ImageLoader.DecodeWidth="900" MaxWidth="760" MaxHeight="300"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Current.WideTileNeedsLogo, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Current.Name}" FontSize="40" FontWeight="SemiBold" Foreground="White" Margin="60,0,60,30"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <Rectangle Grid.Row="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#F6F7F8" Offset="0"/>
                                <GradientStop Color="#D5DADF" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Grid.Row="1" Height="4" VerticalAlignment="Top" Fill="#5EC4EE"/>
                    <Rectangle Grid.Row="1" Fill="{StaticResource ScanlineBrush}"/>
                    <TextBlock Grid.Row="1" x:Name="PreviewInfo" FontSize="22" Foreground="#7A838B" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0">
                        <Button x:Name="MenuButton" Style="{StaticResource PillButton}" Content="Menu" Click="ClosePreview_Click"/>
                        <Button x:Name="StartButton" Style="{StaticResource PillButton}" Content="Démarrer" Margin="120,0,0,0" Click="Start_Click" Tag="focus"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,30,60,0">
                        <Button Style="{StaticResource RoundButton}" Width="96" Height="96" Command="{Binding ToggleFavoriteCommand}" ToolTip="Favori (F)">
                            <TextBlock x:Name="FavGlyph" Text="&#xEB51;" Style="{StaticResource Glyph}" FontSize="30" Foreground="#5E676F"/>
                        </Button>
                        <Button Style="{StaticResource RoundButton}" Width="96" Height="96" Margin="18,0,0,0" Command="{Binding OpenDetailsCommand}" ToolTip="Fiche du jeu">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="30" Foreground="#5E676F"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </c:DesignScaler>
    </Grid>
</sh:ConsoleShell>

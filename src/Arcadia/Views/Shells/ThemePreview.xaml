<UserControl x:Class="Arcadia.Views.Shells.ThemePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" IsHitTestVisible="False">
    <!-- Small hand-drawn mock-ups of each interface (240×135) -->
    <Viewbox Stretch="UniformToFill">
        <Grid Width="240" Height="135" ClipToBounds="True">

            <!-- Arcadia -->
            <Grid Visibility="{Binding Key, ElementName=Root, Converter={StaticResource EqualsToVis}, ConverterParameter=default}" Background="#0E1118">
                <Ellipse Width="200" Height="140" Margin="120,-80,-80,0" Opacity="0.45">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#9A7CFF" Offset="0"/>
                            <GradientStop Color="#009A7CFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Border Width="44" HorizontalAlignment="Left" Background="#131722">
                    <StackPanel Margin="7,10">
                        <Border Width="12" Height="12" CornerRadius="3" HorizontalAlignment="Left" Background="#8E6CFF"/>
                        <Border Height="5" CornerRadius="2" Background="#2A3142" Margin="0,10,0,0"/>
                        <Border Height="5" CornerRadius="2" Background="#3B2F6B" Margin="0,5,0,0"/>
                        <Border Height="5" CornerRadius="2" Background="#2A3142" Margin="0,5,0,0"/>
                        <Border Height="5" CornerRadius="2" Background="#2A3142" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Margin="54,12,10,0" Height="46" VerticalAlignment="Top" CornerRadius="5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3A2C7A" Offset="0"/>
                            <GradientStop Color="#1C3C6E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="54,66,0,0" VerticalAlignment="Top">
                    <Border Width="26" Height="38" CornerRadius="3" Background="#C0504D" Margin="0,0,6,0"/>
                    <Border Width="26" Height="38" CornerRadius="3" Background="#4F81BD" Margin="0,0,6,0"/>
                    <Border Width="26" Height="38" CornerRadius="3" Background="#9BBB59" Margin="0,0,6,0" BorderBrush="#9A7CFF" BorderThickness="1.5"/>
                    <Border Width="26" Height="38" CornerRadius="3" Background="#F79646" Margin="0,0,6,0"/>
                    <Border Width="26" Height="38" CornerRadius="3" Background="#8064A2"/>
                </StackPanel>
            </Grid>

            <!-- Wii -->
            <Grid Visibility="{Binding Key, ElementName=Root, Converter={StaticResource EqualsToVis}, ConverterParameter=wii}">
                <Rectangle Fill="#EEF0F2"/>
                <Rectangle Fill="{StaticResource ScanlineBrush}" Opacity="0.6"/>
                <UniformGrid Rows="3" Columns="4" Margin="18,10,18,38">
                    <Border CornerRadius="4" BorderBrush="#C2C8CF" BorderThickness="1.2" Background="#5BA4E6" Margin="2.5"/>
                    <Border CornerRadius="4" BorderBrush="#4FC6F2" BorderThickness="2" Background="#E7A23B" Margin="2.5"/>
                    <Border CornerRadius="4" BorderBrush="#C2C8CF" BorderThickness="1.2" Background="#7BC26B" Margin="2.5"/>
                    <Border CornerRadius="4" BorderBrush="#C2C8CF" BorderThickness="1.2" Background="#D9534F" Margin="2.5"/>
                    <Border CornerRadius="4" BorderBrush="#C2C8CF" BorderThickness="1.2" Background="#9B7BD0" Margin="2.5"/>
                    <Border CornerRadius="4" BorderBrush="#C2C8CF" BorderThickness="1.2" Background="{StaticResource EmptySlotBrush}" Margin="2.5"/>
                    <Border CornerRadius="4" BorderBrush="#C2C8CF" BorderThickness="1.2" Background="{StaticResource EmptySlotBrush}" Margin="2.5"/>
                    <Border CornerRadius="4" BorderBrush="#C2C8CF" BorderThickness="1.2" Background="{StaticResource EmptySlotBrush}" Margin="2.5"/>
                    <Border CornerRadius="4" BorderBrush="#C2C8CF" BorderThickness="1.2" Background="{StaticResource EmptySlotBrush}" Margin="2.5"/>
                    <Border CornerRadius="4" BorderBrush="#C2C8CF" BorderThickness="1.2" Background="{StaticResource EmptySlotBrush}" Margin="2.5"/>
                    <Border CornerRadius="4" BorderBrush="#C2C8CF" BorderThickness="1.2" Background="{StaticResource EmptySlotBrush}" Margin="2.5"/>
                    <Border CornerRadius="4" BorderBrush="#C2C8CF" BorderThickness="1.2" Background="{StaticResource EmptySlotBrush}" Margin="2.5"/>
                </UniformGrid>
                <Path VerticalAlignment="Bottom" Height="36" Stretch="Fill" Fill="#DDE2E6" Stroke="#5EC4EE" StrokeThickness="1"
                      Data="M 0,12 C 30,12 35,2 60,2 L 95,2 C 110,2 110,12 120,12 C 130,12 130,2 145,2 L 180,2 C 205,2 210,12 240,12 L 240,36 L 0,36 Z"/>
                <Ellipse Width="22" Height="22" Fill="White" Stroke="#A9B1B9" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,6"/>
                <Ellipse Width="22" Height="22" Fill="White" Stroke="#A9B1B9" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,6"/>
                <TextBlock Text="12:00" FontSize="10" Foreground="#9AA2A9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"/>
            </Grid>

            <!-- Wii U -->
            <Grid Visibility="{Binding Key, ElementName=Root, Converter={StaticResource EqualsToVis}, ConverterParameter=wiiu}">
                <Rectangle Fill="#F3F4F6"/>
                <Rectangle Fill="{StaticResource DotGridBrush}"/>
                <Border Margin="14,8,14,0" Height="44" VerticalAlignment="Top" CornerRadius="6">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#29A9E0" Offset="0"/>
                            <GradientStop Color="#6CD3F5" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <UniformGrid Rows="2" Columns="6" Margin="20,60,20,10">
                    <Border CornerRadius="4" Background="#E86C5D" BorderBrush="White" BorderThickness="1.5" Margin="3"/>
                    <Border CornerRadius="4" Background="#5B9BD5" BorderBrush="#00B7F0" BorderThickness="2.5" Margin="3"/>
                    <Border CornerRadius="4" Background="#70AD47" BorderBrush="White" BorderThickness="1.5" Margin="3"/>
                    <Border CornerRadius="4" Background="#FFC000" BorderBrush="White" BorderThickness="1.5" Margin="3"/>
                    <Border CornerRadius="4" Background="#A5A5A5" BorderBrush="White" BorderThickness="1.5" Margin="3"/>
                    <Border CornerRadius="4" Background="#4472C4" BorderBrush="White" BorderThickness="1.5" Margin="3"/>
                    <Border CornerRadius="4" Background="#ED7D31" BorderBrush="White" BorderThickness="1.5" Margin="3"/>
                    <Border CornerRadius="4" Background="#264478" BorderBrush="White" BorderThickness="1.5" Margin="3"/>
                    <Border CornerRadius="4" Background="#9E480E" BorderBrush="White" BorderThickness="1.5" Margin="3"/>
                    <Border CornerRadius="4" Background="#DDE1E5" Margin="3"/>
                    <Border CornerRadius="4" Background="#DDE1E5" Margin="3"/>
                    <Border CornerRadius="4" Background="#DDE1E5" Margin="3"/>
                </UniformGrid>
            </Grid>

            <!-- Switch (dark and light) -->
            <Grid x:Name="SwitchPreview">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Background" Value="#2D2D2D"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Key, ElementName=Root}" Value="switch">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key, ElementName=Root}" Value="switch-light">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Setter Property="Background" Value="#EBEBEB"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Ellipse Width="14" Height="14" Fill="#E8B04B" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,8,0,0"/>
                <TextBlock Text="12:00" FontSize="8" Foreground="#8C8C8C" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"/>
                <StackPanel Orientation="Horizontal" Margin="16,34,0,0" VerticalAlignment="Top">
                    <Grid Margin="0,0,5,0">
                        <Border Width="50" Height="50" Background="#D9534F"/>
                        <Border Margin="-3" BorderBrush="#00C3E3" BorderThickness="2"/>
                    </Grid>
                    <Border Width="50" Height="50" Background="#5B9BD5" Margin="0,0,5,0"/>
                    <Border Width="50" Height="50" Background="#70AD47" Margin="0,0,5,0"/>
                    <Border Width="50" Height="50" Background="#FFC000" Margin="0,0,5,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22">
                    <Ellipse Width="13" Height="13" Fill="#E5484D" Margin="3,0"/>
                    <Ellipse Width="13" Height="13" Fill="#F28C28" Margin="3,0"/>
                    <Ellipse Width="13" Height="13" Fill="#3EA6FF" Margin="3,0"/>
                    <Ellipse Width="13" Height="13" Fill="#9A9A9A" Margin="3,0"/>
                    <Ellipse Width="13" Height="13" Fill="#9A9A9A" Margin="3,0"/>
                </StackPanel>
                <Rectangle Height="1" Fill="#5A5A5A" VerticalAlignment="Bottom" Margin="10,0,10,14"/>
            </Grid>

            <!-- PS3 -->
            <Grid Visibility="{Binding Key, ElementName=Root, Converter={StaticResource EqualsToVis}, ConverterParameter=ps3}">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1B4E8F" Offset="0"/>
                            <GradientStop Color="#0B1C3A" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Path Stroke="#80FFFFFF" StrokeThickness="1.4" Data="M -5,92 C 40,70 80,110 130,86 C 175,64 205,98 250,80"/>
                <Path Stroke="#40FFFFFF" StrokeThickness="5" Data="M -5,98 C 45,80 85,118 135,94 C 180,72 210,104 250,88"/>
                <StackPanel Orientation="Horizontal" Margin="26,30,0,0" VerticalAlignment="Top">
                    <Ellipse Width="9" Height="9" Fill="#99FFFFFF" Margin="0,0,16,0"/>
                    <Ellipse Width="9" Height="9" Fill="#99FFFFFF" Margin="0,0,16,0"/>
                    <Ellipse Width="14" Height="14" Fill="White" Margin="0,-2,16,0"/>
                    <Ellipse Width="9" Height="9" Fill="#99FFFFFF" Margin="0,0,16,0"/>
                    <Ellipse Width="9" Height="9" Fill="#99FFFFFF"/>
                </StackPanel>
                <StackPanel Margin="76,54,0,0" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="16" Background="#E7A23B"/>
                        <Border Width="60" Height="4" Background="White" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0" Opacity="0.6">
                        <Border Width="22" Height="12" Background="#5BA4E6"/>
                        <Border Width="46" Height="3" Background="White" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0" Opacity="0.6">
                        <Border Width="22" Height="12" Background="#7BC26B"/>
                        <Border Width="40" Height="3" Background="White" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- PS4 -->
            <Grid Visibility="{Binding Key, ElementName=Root, Converter={StaticResource EqualsToVis}, ConverterParameter=ps4}">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1665B8" Offset="0"/>
                            <GradientStop Color="#0A2A5C" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Ellipse Width="160" Height="60" Fill="#18FFFFFF" Margin="-40,80,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
                    <Ellipse Width="7" Height="7" Fill="#B3FFFFFF" Margin="4,0"/>
                    <Ellipse Width="7" Height="7" Fill="#B3FFFFFF" Margin="4,0"/>
                    <Ellipse Width="7" Height="7" Fill="#B3FFFFFF" Margin="4,0"/>
                    <Ellipse Width="7" Height="7" Fill="#B3FFFFFF" Margin="4,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="20,40,0,0" VerticalAlignment="Top">
                    <Border Width="58" Height="58" Background="#C0504D" BorderBrush="White" BorderThickness="1.5"/>
                    <Border Width="34" Height="34" Background="#4F81BD" Margin="6,0,0,0" VerticalAlignment="Top"/>
                    <Border Width="34" Height="34" Background="#9BBB59" Margin="5,0,0,0" VerticalAlignment="Top"/>
                    <Border Width="34" Height="34" Background="#F79646" Margin="5,0,0,0" VerticalAlignment="Top"/>
                    <Border Width="34" Height="34" Background="#8064A2" Margin="5,0,0,0" VerticalAlignment="Top"/>
                </StackPanel>
                <Border Width="58" Height="12" CornerRadius="2" Background="#33FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,104,0,0"/>
            </Grid>

            <!-- PS5 -->
            <Grid Visibility="{Binding Key, ElementName=Root, Converter={StaticResource EqualsToVis}, ConverterParameter=ps5}" Background="#0B0D12">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                            <GradientStop Color="#8A5A2B" Offset="0"/>
                            <GradientStop Color="#2E3A55" Offset="0.5"/>
                            <GradientStop Color="#0B0D12" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel Orientation="Horizontal" Margin="14,10,0,0" VerticalAlignment="Top">
                    <TextBlock Text="Jeux" FontSize="7" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock Text="Médias" FontSize="7" Foreground="#99FFFFFF" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="14,26,0,0" VerticalAlignment="Top">
                    <Border Width="30" Height="30" CornerRadius="4" Background="#E7A23B" BorderBrush="White" BorderThickness="1.2"/>
                    <Border Width="20" Height="20" CornerRadius="3" Background="#5B9BD5" Margin="5,0,0,0" VerticalAlignment="Top"/>
                    <Border Width="20" Height="20" CornerRadius="3" Background="#7BC26B" Margin="4,0,0,0" VerticalAlignment="Top"/>
                    <Border Width="20" Height="20" CornerRadius="3" Background="#D9534F" Margin="4,0,0,0" VerticalAlignment="Top"/>
                    <Border Width="20" Height="20" CornerRadius="3" Background="#9B7BD0" Margin="4,0,0,0" VerticalAlignment="Top"/>
                </StackPanel>
                <Border Width="80" Height="16" CornerRadius="2" Background="#CCFFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,72,0,0"/>
                <Border Width="40" Height="12" CornerRadius="6" Background="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,98,0,0"/>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>

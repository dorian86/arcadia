<UserControl x:Class="Arcadia.Views.DuplicatesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Arcadia.Controls"
             xmlns:vm="clr-namespace:Arcadia.ViewModels">
    <UserControl.Resources>
        <!-- one copy of the game: click it to keep it -->
        <Style x:Key="CopyRow" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource Surface2}" BorderThickness="2" BorderBrush="Transparent" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="22" Height="22" VerticalAlignment="Center">
                                    <Ellipse x:Name="Ring" Stroke="{StaticResource StrokeStrong}" StrokeThickness="2"/>
                                    <Ellipse x:Name="Dot" Margin="5" Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Game.Name}" Foreground="{StaticResource TextPrimary}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Path}" Foreground="{StaticResource TextMuted}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                               FontFamily="Cascadia Mono, Consolas" Margin="0,2,0,0" ToolTip="{Binding Path}"/>
                                </StackPanel>
                                <Border x:Name="KeepBadge" Grid.Column="2" CornerRadius="7" Padding="9,3" Background="{DynamicResource AccentSoft}"
                                        VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Gardé" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeStrong}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsKept}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="KeepBadge" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource DialogCard}" Width="820" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="30,26,22,0">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="48" Height="48">
                        <Ellipse Fill="{DynamicResource AccentGlow}" Margin="-14"/>
                        <Ellipse Fill="{DynamicResource AccentGradient}"/>
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="18" Foreground="White"/>
                    </Grid>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" MaxWidth="640">
                        <TextBlock Text="Jeux en double" Style="{StaticResource SectionTitle}" FontSize="22"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" c:Ui.Glyph="&#xE8BB;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding CloseCommand}" ToolTip="Fermer (Échap)"/>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,20,0,0" MaxHeight="540" VerticalScrollBarVisibility="Auto" c:SmoothScroll.IsEnabled="True">
                <ItemsControl ItemsSource="{Binding Groups}" Margin="30,0,30,10" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DuplicateGroup}">
                            <Border CornerRadius="14" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="16,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="2,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding CountText}" FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="10,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource GhostButton}" Content="Ce ne sont pas des doublons" Height="34" FontSize="12.5"
                                                    Command="{Binding DataContext.NotDuplicateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource SecondaryButton}" Content="Fusionner" c:Ui.Glyph="&#xE8C8;" Height="34" FontSize="12.5" Margin="6,0,0,0"
                                                    ToolTip="Garde l'entrée choisie et y regroupe le temps de jeu, les notes, les favoris et les collections"
                                                    Command="{Binding DataContext.MergeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Copies}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:DuplicateCopy}">
                                                <Button Style="{StaticResource CopyRow}" ToolTip="Garder cette entrée"
                                                        Command="{Binding DataContext.KeepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="30,16" CornerRadius="0,0,18,18" Background="{StaticResource Bg1}">
                <Grid>
                    <TextBlock Text="Les fichiers des jeux ne sont jamais touchés : seules les entrées d'Arcadia sont regroupées." FontSize="12"
                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Content="Plus tard" Command="{Binding CloseCommand}"/>
                        <Button Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" c:Ui.Glyph="&#xE8C8;" Content="Tout fusionner" Command="{Binding MergeAllCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="Arcadia.Views.ScanDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Arcadia.Controls"
             xmlns:vm="clr-namespace:Arcadia.ViewModels">
    <Border Style="{StaticResource DialogCard}" Width="820" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="30,26,22,0">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="48" Height="48">
                        <Ellipse Fill="{DynamicResource AccentGlow}" Margin="-14"/>
                        <Ellipse Fill="{DynamicResource AccentGradient}"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="18" Foreground="White"/>
                    </Grid>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="22"/>
                        <TextBlock Text="{Binding Subtitle}" MaxWidth="660" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}"
                                   FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" c:Ui.Glyph="&#xE8BB;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding CloseCommand}" ToolTip="Fermer (Échap)"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,20,0,0" MinHeight="300">
                <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" c:SmoothScroll.IsEnabled="True">
                    <ItemsControl ItemsSource="{Binding Groups}" Margin="30,0,30,10" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ScanGroup}">
                                <StackPanel Margin="0,0,0,18">
                                    <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="{Binding CountText}" FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="10,1,0,0"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ScanEntry}">
                                                <Border x:Name="Row" CornerRadius="10" Padding="12,9" Margin="0,2" Background="{StaticResource Surface2}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Style="{StaticResource CheckBoxModern}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"
                                                                  VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMuted}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                                       FontFamily="Cascadia Mono, Consolas" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border CornerRadius="7" Padding="9,3" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                                    Visibility="{Binding Note, Converter={StaticResource NullToVis}}" ToolTip="Ce qui montre que c'est un jeu">
                                                                <TextBlock Text="{Binding Note}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                                            </Border>
                                                            <Border CornerRadius="7" Padding="9,3" Background="#263DDC97" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                    Visibility="{Binding InLibrary, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="Déjà dans Arcadia" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                                                            </Border>
                                                            <Button Style="{StaticResource IconButton}" c:Ui.Glyph="&#xE838;" FontSize="12" Width="30" Height="30" Margin="6,0,0,0"
                                                                    Command="{Binding RevealCommand}" ToolTip="Afficher dans l'Explorateur"
                                                                    Visibility="{Binding CanReveal, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding InLibrary}" Value="True">
                                                        <Setter TargetName="Row" Property="Opacity" Value="0.6"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                    <c:Spinner Width="36" Height="36"/>
                    <TextBlock Text="{Binding ScanningText}" Foreground="{StaticResource TextSecondary}" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ScanningDetail}" Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,6,0,0" HorizontalAlignment="Center"
                               MaxWidth="620" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas"/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" TextAlignment="Center" MaxWidth="480"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Status, Converter={StaticResource NullToVis}}"/>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="30,16" CornerRadius="0,0,18,18"
                    Background="{StaticResource Bg1}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="Tout cocher" Height="34" FontSize="13" Command="{Binding SelectAllCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Content="Tout décocher" Height="34" FontSize="13" Command="{Binding SelectNoneCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Content="Relancer" c:Ui.Glyph="&#xE72C;" Height="34" FontSize="13" Command="{Binding ScanCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Content="Annuler" Command="{Binding CloseCommand}"/>
                        <Button Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" c:Ui.Glyph="&#xE710;" Command="{Binding ImportCommand}"
                                IsEnabled="{Binding SelectedCount, Converter={StaticResource CountToBool}}">
                            <TextBlock>
                                <Run Text="Ajouter"/>
                                <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                                <Run Text="jeu(x)"/>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="Arcadia.Views.OnboardingDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Arcadia.Controls"
             xmlns:vm="clr-namespace:Arcadia.ViewModels"
             xmlns:s="clr-namespace:Arcadia.Services"
             xmlns:sh="clr-namespace:Arcadia.Views.Shells">
    <UserControl.Resources>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource DialogCard}" Width="920" Padding="0" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="540"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===================== 1. Welcome ===================== -->
            <Grid Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVis}}">
                <Ellipse Fill="{DynamicResource AccentGlow}" Width="700" Height="700" Margin="0,-360,0,0" VerticalAlignment="Top" Opacity="0.55"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600">
                    <Grid Width="96" Height="96" HorizontalAlignment="Center">
                        <Border CornerRadius="26" Background="{DynamicResource LogoGradient}"/>
                        <TextBlock Text="A" FontFamily="{StaticResource DisplayFont}" FontSize="52" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                    </Grid>
                    <TextBlock Text="Bienvenue dans Arcadia" Style="{StaticResource StepTitle}" FontSize="36" HorizontalAlignment="Center" Margin="0,26,0,0"/>
                    <TextBlock Text="Tous tes jeux PC réunis au même endroit. On prépare ta bibliothèque en trois petites étapes."
                               Style="{StaticResource StepText}" TextAlignment="Center" FontSize="15"/>
                    <UniformGrid Columns="3" Margin="0,34,0,0">
                        <StackPanel Margin="10,0">
                            <TextBlock Text="&#xE8F1;" Style="{StaticResource Glyph}" FontSize="24" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Text="Steam, Epic, GOG, Ubisoft, Xbox, .exe et émulateurs" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="10,0">
                            <TextBlock Text="&#xE734;" Style="{StaticResource Glyph}" FontSize="24" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Text="Jaquettes, temps de jeu, succès et trophées" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="10,0">
                            <TextBlock Text="&#xE7FC;" Style="{StaticResource Glyph}" FontSize="24" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Text="Thèmes façon consoles et mode TV à la manette" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <!-- ===================== 2. Games ===================== -->
            <StackPanel Visibility="{Binding IsGames, Converter={StaticResource BoolToVis}}" Margin="48,44,48,0">
                <TextBlock Text="Tes jeux" Style="{StaticResource StepTitle}"/>
                <TextBlock Text="Arcadia cherche les jeux installés dans tes launchers. Il ne modifie, ne déplace et ne supprime jamais les fichiers de tes jeux."
                           Style="{StaticResource StepText}"/>

                <Border Margin="0,26,0,0" CornerRadius="16" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="26,22" MinHeight="190">
                    <Grid>
                        <!-- scanning -->
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="28" Foreground="{DynamicResource Accent}"/>
                            <TextBlock Text="Recherche des jeux installés…" FontSize="15" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                        <!-- found -->
                        <StackPanel Visibility="{Binding HasNewGames, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" Foreground="White">
                                <Run Text="{Binding NewCount, Mode=OneWay}"/>
                                <Run Text="jeux trouvés"/>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Launchers}" Margin="0,14,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LauncherCount}">
                                        <Border CornerRadius="10" Background="#14FFFFFF" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="12,7" Margin="0,0,10,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding Count}" Foreground="{StaticResource TextMuted}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource PrimaryButton}" c:Ui.Glyph="&#xE710;" HorizontalAlignment="Left" Height="44" Padding="22,0" Margin="0,8,0,0"
                                    Command="{Binding ImportFoundCommand}" IsEnabled="{Binding IsImporting, Converter={StaticResource InvertBool}}">
                                <TextBlock>
                                    <Run Text="Ajouter les"/>
                                    <Run Text="{Binding NewCount, Mode=OneWay}"/>
                                    <Run Text="jeux"/>
                                </TextBlock>
                            </Button>
                        </StackPanel>
                        <!-- imported -->
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding HasImported, Converter={StaticResource BoolToVis}}">
                            <Grid Width="56" Height="56" HorizontalAlignment="Center">
                                <Ellipse Fill="{DynamicResource AccentGradient}"/>
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="22" Foreground="White"/>
                            </Grid>
                            <TextBlock HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="White" Margin="0,14,0,0">
                                <Run Text="{Binding ImportedCount, Mode=OneWay}"/>
                                <Run Text="jeux ajoutés à ta bibliothèque !"/>
                            </TextBlock>
                            <TextBlock Text="Arcadia récupère leurs jaquettes et leurs informations en arrière-plan." FontSize="13" Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <!-- nothing new -->
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding NothingFound, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="26" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="Aucun nouveau jeu trouvé dans Steam, Epic Games, GOG, Ubisoft Connect ou l'application Xbox." FontSize="14"
                                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="D'autres jeux ? Raccourcis du bureau, .exe, jeux d'émulateurs…" FontSize="13.5" Foreground="{StaticResource TextPrimary}" Margin="0,26,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" c:Ui.Glyph="&#xE8E5;" Content="Ajouter des fichiers…" Command="{Binding Main.AddGamesCommand}"/>
                    <Button Style="{StaticResource SecondaryButton}" c:Ui.Glyph="&#xE8B7;" Content="Chercher dans un dossier…" Command="{Binding Main.ImportFolderCommand}" Margin="10,0,0,0"/>
                    <TextBlock Text="ou glisse-les dans la fenêtre d'Arcadia" FontSize="12.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- ===================== 3. Theme ===================== -->
            <StackPanel Visibility="{Binding IsTheme, Converter={StaticResource BoolToVis}}" Margin="48,44,40,0">
                <TextBlock Text="Ton interface" Style="{StaticResource StepTitle}"/>
                <TextBlock Text="L'interface Arcadia, ou une interface dans l'esprit des menus de consoles. Tu pourras en changer à tout moment avec le bouton « Thèmes »."
                           Style="{StaticResource StepText}" Margin="0,8,8,0"/>
                <ItemsControl ItemsSource="{Binding Themes}" Margin="-6,24,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ThemeChoice}">
                            <Button Style="{StaticResource BareButton}" Margin="6,0,6,16"
                                    Command="{Binding DataContext.PickThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <Grid>
                                        <Border x:Name="Ring" CornerRadius="12" Margin="-3" BorderThickness="2.5" BorderBrush="{DynamicResource AccentGradient}" Opacity="0"/>
                                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource Stroke}" Height="104">
                                            <Border CornerRadius="9" ClipToBounds="True">
                                                <Border.OpacityMask>
                                                    <VisualBrush>
                                                        <VisualBrush.Visual>
                                                            <Border Width="186" Height="104" CornerRadius="9" Background="Black"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Border.OpacityMask>
                                                <sh:ThemePreview Key="{Binding Theme.Key}"/>
                                            </Border>
                                        </Border>
                                        <Grid x:Name="Check" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" Visibility="Collapsed">
                                            <Ellipse Fill="{DynamicResource AccentGradient}"/>
                                            <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="11" Foreground="White"/>
                                        </Grid>
                                    </Grid>
                                    <TextBlock x:Name="Name" Text="{Binding Theme.Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="3,9,3,0"/>
                                </StackPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="0.6"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===================== 4. Colour and wallpaper ===================== -->
            <StackPanel Visibility="{Binding IsLook, Converter={StaticResource BoolToVis}}" Margin="48,44,48,0">
                <TextBlock Text="Tes couleurs" Style="{StaticResource StepTitle}"/>
                <TextBlock Text="Choisis la couleur d'Arcadia et, si tu veux, une image en fond d'écran." Style="{StaticResource StepText}"/>

                <TextBlock Text="COULEUR D'ACCENT" Style="{StaticResource Overline}" Margin="0,28,0,12"/>
                <ItemsControl ItemsSource="{Binding Main.AccentPresets}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type s:AccentPreset}">
                            <Button Margin="0,0,16,8" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="{Binding Label}"
                                    Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SelectAccentCommand}" CommandParameter="{Binding Name}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <StackPanel Background="Transparent">
                                            <Grid Width="62" Height="62">
                                                <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2.5"/>
                                                <Ellipse Margin="6">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="{Binding A}" Offset="0"/>
                                                            <GradientStop Color="{Binding B}" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock x:Name="Check" Text="&#xE73E;" Style="{StaticResource Glyph}" Foreground="White" FontSize="16" Visibility="Collapsed"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource EqualsMulti}">
                                                        <Binding Path="Name"/>
                                                        <Binding Source="{x:Static vm:MainViewModel.Instance}" Path="Settings.AccentPreset"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter TargetName="Ring" Property="Stroke" Value="White"/>
                                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Ring" Property="Stroke" Value="#66FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="FOND D'ÉCRAN (FACULTATIF)" Style="{StaticResource Overline}" Margin="0,26,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <Border Width="176" Height="99" CornerRadius="12" ClipToBounds="True" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="&#xEB9F;" Style="{StaticResource Glyph}" FontSize="24" Foreground="{StaticResource TextMuted}"/>
                            <Border CornerRadius="11" c:ImageLoader.Source="{Binding Main.WallpaperPath}" c:ImageLoader.DecodeWidth="360"
                                    Visibility="{Binding Main.HasWallpaper, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Une image de ton choix derrière l'interface Arcadia, assombrie pour que tout reste lisible." FontSize="13"
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" MaxWidth="440"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource SecondaryButton}" c:Ui.Glyph="&#xEB9F;" Content="Choisir une image…" Command="{Binding Main.ChooseWallpaperCommand}"/>
                            <Button Style="{StaticResource GhostButton}" Content="Retirer" Margin="8,0,0,0" Command="{Binding Main.RemoveWallpaperCommand}"
                                    Visibility="{Binding Main.HasWallpaper, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- ===================== Footer ===================== -->
            <Border Grid.Row="1" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="28,16,28,18">
                <Grid>
                    <Button Style="{StaticResource GhostButton}" Content="Passer" HorizontalAlignment="Left" Height="42" Command="{Binding SkipCommand}"
                            ToolTip="Fermer l'assistant (il reste disponible dans les réglages)"/>
                    <ItemsControl ItemsSource="{Binding Dots}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Dot" Width="8" Height="8" CornerRadius="4" Margin="4,0" Background="#40FFFFFF"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource EqualsMulti}">
                                                <Binding/>
                                                <Binding Path="DataContext.Step" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter TargetName="Dot" Property="Width" Value="26"/>
                                        <Setter TargetName="Dot" Property="Background" Value="{DynamicResource AccentGradient}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Content="Retour" Height="42" Margin="0,0,10,0" Command="{Binding BackCommand}"
                                Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}"/>
                        <Button Height="42" Padding="24,0" Command="{Binding NextCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Content" Value="Suivant"/>
                                    <Setter Property="c:Ui.Glyph" Value="&#xE72A;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWelcome}" Value="True">
                                            <Setter Property="Content" Value="Commencer"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                            <Setter Property="Content" Value="C'est parti !"/>
                                            <Setter Property="c:Ui.Glyph" Value="&#xE768;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="Arcadia.Views.UpdateDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Arcadia.Controls">
    <Border Style="{StaticResource DialogCard}" Width="600" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="30,26,22,0">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="48" Height="48">
                        <Ellipse Fill="{DynamicResource AccentGlow}" Margin="-14"/>
                        <Ellipse Fill="{DynamicResource AccentGradient}"/>
                        <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="19" Foreground="White"/>
                    </Grid>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" MaxWidth="440">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="22"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" c:Ui.Glyph="&#xE8BB;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding CloseCommand}" ToolTip="Fermer (Échap)"/>
            </Grid>

            <Border Grid.Row="1" Margin="30,22,30,0" CornerRadius="12" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" c:SmoothScroll.IsEnabled="True" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="NOUVEAUTÉS" Style="{StaticResource Overline}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Notes}" FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Margin="30,18,30,26">
                <!-- download progress -->
                <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                    <TextBlock Text="Téléchargement… Arcadia redémarrera tout seul." FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                    <Grid Height="6">
                        <Border CornerRadius="3" Background="{StaticResource Surface2}"/>
                        <Border CornerRadius="3" Background="{DynamicResource AccentGradient}" HorizontalAlignment="Left"
                                Width="{Binding Progress, Converter={StaticResource RatioToLength}, ConverterParameter=540}"/>
                    </Grid>
                </StackPanel>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="{Binding Error, Converter={StaticResource NullToVis}}"/>
                <Grid>
                    <Button Style="{StaticResource GhostButton}" Content="Ignorer cette version" HorizontalAlignment="Left" Height="40" FontSize="13"
                            Command="{Binding SkipCommand}" IsEnabled="{Binding IsIdle}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Content="Plus tard" Height="40" Command="{Binding CloseCommand}" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource PrimaryButton}" c:Ui.Glyph="&#xE896;" Content="Mettre à jour" Height="40"
                                Command="{Binding InstallCommand}" IsEnabled="{Binding IsIdle}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

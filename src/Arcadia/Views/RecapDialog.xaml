<UserControl x:Class="Arcadia.Views.RecapDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Arcadia.Controls"
             xmlns:vm="clr-namespace:Arcadia.ViewModels">
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <Style x:Key="Big" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Fact" TargetType="TextBlock" BasedOn="{StaticResource Big}">
            <Setter Property="FontSize" Value="20"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource DialogCard}" Width="1000" Padding="0" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Height="150" ClipToBounds="True">
                <Border Background="{DynamicResource AccentGradient}" CornerRadius="16,16,0,0"/>
                <Ellipse Fill="#30FFFFFF" Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-210,120,0"/>
                <Ellipse Fill="#20FFFFFF" Width="220" Height="220" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-80,0,0,-150"/>
                <Grid Margin="34,0,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TON ANNÉE DE JEU" FontSize="13" FontWeight="Bold" Foreground="#E6FFFFFF"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Button Style="{StaticResource IconButton}" c:Ui.Glyph="&#xE76B;" Foreground="White" VerticalAlignment="Center"
                                    Command="{Binding PreviousYearCommand}" ToolTip="Année précédente"/>
                            <TextBlock Text="{Binding YearText}" FontFamily="{StaticResource DisplayFont}" FontSize="52" FontWeight="Bold" Foreground="White" Margin="6,-6,6,0"/>
                            <Button Style="{StaticResource IconButton}" c:Ui.Glyph="&#xE76C;" Foreground="White" VerticalAlignment="Center"
                                    Command="{Binding NextYearCommand}" ToolTip="Année suivante"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Period}" FontSize="13" Foreground="#E6FFFFFF"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" c:Ui.Glyph="&#xE8BB;" FontSize="11" Foreground="White" VerticalAlignment="Top" Margin="0,18,0,0"
                            Command="{Binding CloseCommand}" ToolTip="Fermer (Échap)"/>
                </Grid>
            </Grid>

            <ScrollViewer Grid.Row="1" MaxHeight="640" VerticalScrollBarVisibility="Auto" c:SmoothScroll.IsEnabled="True">
                <Grid Margin="34,26,22,26">
                    <!-- nothing played that year -->
                    <StackPanel Visibility="{Binding HasPlay, Converter={StaticResource InvBoolToVis}}" Margin="0,20,12,30" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource Glyph}" FontSize="40" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Pas encore de partie cette année" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="Lance tes jeux depuis Arcadia : chaque partie compte pour ton récap." Style="{StaticResource BodyText}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasPlay, Converter={StaticResource BoolToVis}}">
                        <!-- key figures -->
                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="TEMPS DE JEU" Style="{StaticResource Overline}"/>
                                    <TextBlock Text="{Binding TotalTime}" Style="{StaticResource Big}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="JEUX JOUÉS" Style="{StaticResource Overline}"/>
                                    <TextBlock Text="{Binding GamesPlayed}" Style="{StaticResource Big}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="SESSIONS" Style="{StaticResource Overline}"/>
                                    <TextBlock Text="{Binding Sessions}" Style="{StaticResource Big}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="SUCCÈS OBTENUS" Style="{StaticResource Overline}"/>
                                    <TextBlock Text="{Binding Achievements}" Style="{StaticResource Big}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- game of the year + top 5 -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="400"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource BareButton}" Margin="0,0,12,12" Cursor="Hand"
                                    Command="{Binding OpenGameCommand}" CommandParameter="{Binding GameOfTheYear}" ToolTip="Voir la fiche du jeu">
                                <Border CornerRadius="16" ClipToBounds="True" Height="250" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                                    <Grid>
                                        <Border CornerRadius="15" Background="{StaticResource Surface2}"
                                                c:ImageLoader.Source="{Binding GameOfTheYear.WideArtPath}" c:ImageLoader.DecodeWidth="800"/>
                                        <Border CornerRadius="15">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#200A0C11" Offset="0"/>
                                                    <GradientStop Color="#F20A0C11" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel VerticalAlignment="Bottom" Margin="20,0,20,18">
                                            <Border CornerRadius="8" Background="{DynamicResource AccentGradient}" Padding="10,4" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE735;" Style="{StaticResource Glyph}" FontSize="11" Foreground="White"/>
                                                    <TextBlock Text="TON JEU DE L'ANNÉE" FontSize="11" FontWeight="Bold" Foreground="White" Margin="6,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding GameOfTheYear.Name}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" Foreground="White"
                                                       TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
                                            <TextBlock Text="{Binding GameOfTheYearText}" FontSize="12.5" Foreground="#D9FFFFFF" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                            <Border Grid.Column="1" Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="TES JEUX LES PLUS JOUÉS" Style="{StaticResource Overline}" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding TopGames}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:BarItem}">
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="26" Height="38" CornerRadius="5" Background="{Binding Game.Name, Converter={StaticResource NameToBrush}}">
                                                        <Border CornerRadius="5" c:ImageLoader.Source="{Binding Game.CoverFullPath}" c:ImageLoader.DecodeWidth="40"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                        <Grid Height="5" Margin="0,6,0,0">
                                                            <Border CornerRadius="3" Background="{StaticResource Surface3}"/>
                                                            <Border CornerRadius="3" Background="{DynamicResource AccentGradient}" RenderTransformOrigin="0,0.5">
                                                                <Border.RenderTransform><ScaleTransform ScaleX="{Binding Ratio}"/></Border.RenderTransform>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- months -->
                        <Border Style="{StaticResource Tile}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Overline}">
                                    <Run Text="TON ANNÉE MOIS PAR MOIS  ·  MEILLEUR MOIS :"/>
                                    <Run Text="{Binding BestMonth, Mode=OneWay}"/>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Months}" Height="150" Margin="0,14,0,0" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:BarItem}">
                                            <Grid Margin="5,0" ToolTip="{Binding Tooltip}" Background="Transparent">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Value}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <Border Grid.Row="1" VerticalAlignment="Bottom" CornerRadius="6,6,2,2" Background="{DynamicResource AccentGradient}"
                                                        Height="{Binding Ratio, Converter={StaticResource RatioToLength}, ConverterParameter=96}"/>
                                                <TextBlock Grid.Row="2" Text="{Binding Label}" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- fun facts -->
                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="PLUS LONGUE PARTIE" Style="{StaticResource Overline}"/>
                                    <TextBlock Text="{Binding LongestSession}" Style="{StaticResource Fact}"/>
                                    <TextBlock Text="{Binding LongestSessionDetail}" FontSize="12" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="TON JOUR DE JEU" Style="{StaticResource Overline}"/>
                                    <TextBlock Text="{Binding FavoriteDay}" Style="{StaticResource Fact}"/>
                                    <TextBlock Text="{Binding FavoriteMoment}" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="NOUVEAUX JEUX" Style="{StaticResource Overline}"/>
                                    <TextBlock Text="{Binding GamesAdded}" Style="{StaticResource Fact}"/>
                                    <TextBlock Text="ajoutés à la bibliothèque" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="TROPHÉES ARCADIA" Style="{StaticResource Overline}"/>
                                    <TextBlock Text="{Binding TrophiesUnlocked}" Style="{StaticResource Fact}"/>
                                    <TextBlock Text="obtenus cette année" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="D'après les parties lancées depuis Arcadia (le temps de jeu importé de Steam n'a pas de date)." FontSize="11.5"
                                   Foreground="{StaticResource TextMuted}" Margin="2,4,0,0"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>

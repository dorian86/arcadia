<UserControl x:Class="Arcadia.Views.RouletteDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Arcadia.Controls"
             xmlns:m="clr-namespace:Arcadia.Models">
    <Border Style="{StaticResource DialogCard}" Width="1040" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="30,26,22,0">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="48" Height="48">
                        <Ellipse Fill="{DynamicResource AccentGlow}" Margin="-14"/>
                        <Ellipse Fill="{DynamicResource AccentGradient}"/>
                        <TextBlock Text="&#xE8B1;" Style="{StaticResource Glyph}" FontSize="18" Foreground="White"/>
                    </Grid>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Je ne sais pas à quoi jouer" Style="{StaticResource SectionTitle}" FontSize="22"/>
                        <TextBlock Text="Laissez le hasard choisir (les jeux « À faire » et vos favoris ont plus de chances)."
                                   FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" c:Ui.Glyph="&#xE8BB;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding CloseCommand}" ToolTip="Fermer (Échap)"/>
            </Grid>

            <!-- Filters -->
            <WrapPanel Grid.Row="1" Margin="30,18,30,0" IsEnabled="{Binding IsSpinning, Converter={StaticResource InvertBool}}">
                <Button Style="{StaticResource StatusPill}" c:Ui.Glyph="&#xE8F1;" Content="Tous les jeux" c:Ui.IsActive="{Binding F0}"
                        Command="{Binding SelectFilterCommand}" CommandParameter="0" Foreground="{StaticResource TextPrimary}"/>
                <Button Style="{StaticResource StatusPill}" c:Ui.Glyph="&#xE7C3;" Content="Jamais lancés" c:Ui.IsActive="{Binding F1}"
                        Command="{Binding SelectFilterCommand}" CommandParameter="1" Foreground="{StaticResource TextPrimary}"/>
                <Button Style="{StaticResource StatusPill}" c:Ui.Glyph="&#xE728;" Content="À faire" c:Ui.IsActive="{Binding F2}"
                        Command="{Binding SelectFilterCommand}" CommandParameter="2" Foreground="{StaticResource TextPrimary}"/>
                <Button Style="{StaticResource StatusPill}" c:Ui.Glyph="&#xEB51;" Content="Favoris" c:Ui.IsActive="{Binding F3}"
                        Command="{Binding SelectFilterCommand}" CommandParameter="3" Foreground="{StaticResource TextPrimary}"/>
            </WrapPanel>

            <!-- Wheel -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="Viewport" Height="320" ClipToBounds="True" Background="#66000000">
                    <Canvas>
                        <ItemsControl x:Name="StripHost" ItemsSource="{Binding Strip}" Canvas.Top="30" Focusable="False">
                            <ItemsControl.RenderTransform><TranslateTransform/></ItemsControl.RenderTransform>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Width" Value="170"/>
                                    <Setter Property="Margin" Value="0,0,18,0"/>
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:Game}">
                                    <Border CornerRadius="12" Background="{Binding Name, Converter={StaticResource NameToBrush}}">
                                        <c:AspectRatioBox Ratio="1.5">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"
                                                           TextAlignment="Center" VerticalAlignment="Center" Margin="12"/>
                                                <Border CornerRadius="12" c:ImageLoader.Source="{Binding CoverFullPath}" c:ImageLoader.DecodeWidth="200"/>
                                                <Border CornerRadius="12" BorderThickness="1" BorderBrush="#26FFFFFF"/>
                                            </Grid>
                                        </c:AspectRatioBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                    <!-- edge fades -->
                    <Rectangle Width="220" HorizontalAlignment="Left" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF141822" Offset="0"/>
                                <GradientStop Color="#00141822" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Width="220" HorizontalAlignment="Right" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                <GradientStop Color="#FF141822" Offset="0"/>
                                <GradientStop Color="#00141822" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- centre marker -->
                    <Grid HorizontalAlignment="Center" IsHitTestVisible="False">
                        <Border Width="4" CornerRadius="2" Background="{DynamicResource AccentGradient}" Margin="0,8"/>
                        <Ellipse Width="60" Fill="{DynamicResource AccentGlow}" Margin="-28,0" Opacity="0.5"/>
                        <Path Data="M 0,0 L 18,0 L 9,12 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"/>
                        <Path Data="M 0,12 L 18,12 L 9,0 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    </Grid>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" TextAlignment="Center" MaxWidth="520"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"
                               Visibility="{Binding Status, Converter={StaticResource NullToVis}}"/>
                </Grid>

                <!-- Result / actions -->
                <Grid Grid.Row="1" Margin="30,22,30,28" MinHeight="64">
                    <StackPanel VerticalAlignment="Center" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="CE SERA…" Style="{StaticResource Overline}"/>
                        <TextBlock Text="{Binding Winner.Name}" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="520" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding Winner.MetaLine}" Foreground="{StaticResource TextSecondary}" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="520" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <TextBlock Text="La roulette tourne…" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                               Visibility="{Binding IsSpinning, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Content="Relancer" c:Ui.Glyph="&#xE8B1;" Height="48" Padding="18,0"
                                Command="{Binding SpinCommand}" Visibility="{Binding IsSpinning, Converter={StaticResource InvBoolToVis}}"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Voir la fiche" c:Ui.Glyph="&#xE946;" Height="48" Padding="18,0" Margin="10,0,0,0"
                                Command="{Binding ShowWinnerCommand}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource PlayButton}" Content="JOUER" Margin="14,0,0,0"
                                Command="{Binding PlayWinnerCommand}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>

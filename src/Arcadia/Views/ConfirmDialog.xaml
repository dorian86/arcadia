<UserControl x:Class="Arcadia.Views.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource DialogCard}" Width="500">
        <StackPanel>
            <Grid Width="52" Height="52" HorizontalAlignment="Left">
                <Ellipse x:Name="IconBg" Fill="{DynamicResource AccentSoft}"/>
                <TextBlock x:Name="IconGlyph" Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="20" Foreground="{DynamicResource Accent}"/>
            </Grid>
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="21" Margin="0,20,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource BodyText}" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                <Button Style="{StaticResource GhostButton}" Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsCancel="True"/>
                <Button x:Name="ConfirmPrimary" Style="{StaticResource PrimaryButton}" Content="{Binding ConfirmText}" Margin="10,0,0,0"
                        Command="{Binding ConfirmCommand}" IsDefault="True"/>
                <Button x:Name="ConfirmDanger" Style="{StaticResource DangerButton}" Content="{Binding ConfirmText}" Margin="10,0,0,0"
                        Command="{Binding ConfirmCommand}" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

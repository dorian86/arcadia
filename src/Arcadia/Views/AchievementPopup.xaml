<Window x:Class="Arcadia.Views.AchievementPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Arcadia.Controls"
        Title="Arcadia — succès" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        SizeToContent="WidthAndHeight" IsHitTestVisible="False">
    <!-- Shown over the game (bottom right) when an achievement is unlocked: never takes the focus, clicks go through -->
    <Grid Margin="24">
        <Border x:Name="Card" CornerRadius="16" Padding="14,12,22,12" MinWidth="340" MaxWidth="440" Background="#F2141822"
                BorderBrush="#66FFC94D" BorderThickness="1.5" Opacity="0">
            <Border.RenderTransform><TranslateTransform x:Name="Slide" X="60"/></Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.6" Color="Black"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Grid Width="60" Height="60">
                    <Border CornerRadius="10" Background="#33FFC94D"/>
                    <TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" Foreground="#FFC94D"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border CornerRadius="10" ClipToBounds="True">
                        <Image c:ImageLoader.Source="{Binding Icon}" c:ImageLoader.DecodeWidth="128" Stretch="UniformToFill"/>
                    </Border>
                </Grid>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="340">
                    <TextBlock Text="SUCCÈS DÉBLOQUÉ" FontSize="11" FontWeight="Bold" Foreground="#FFC94D"/>
                    <TextBlock Text="{Binding Name}" FontSize="16.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Detail}" FontSize="12.5" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

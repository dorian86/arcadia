<UserControl x:Class="Arcadia.Views.TvModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Arcadia.Controls"
             xmlns:m="clr-namespace:Arcadia.Models"
             xmlns:vm="clr-namespace:Arcadia.ViewModels"
             Background="#0A0C11" Focusable="True" FocusVisualStyle="{x:Null}" Cursor="None">
    <UserControl.Resources>
        <Style x:Key="PadHint" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#D9FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,34,0"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <!-- Backdrop (cross-faded in code) -->
        <Grid>
            <Grid>
                <Border x:Name="BgA" c:ImageLoader.Fade="False" RenderOptions.BitmapScalingMode="Linear"/>
                <Border x:Name="BgB" c:ImageLoader.Fade="False" RenderOptions.BitmapScalingMode="Linear" Opacity="0"/>
            </Grid>
            <c:TrailerPlayer x:Name="Trailer" TargetOpacity="0.8"/>
        </Grid>
        <Ellipse Width="1800" Height="1300" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-600,-700,0" Opacity="0.4"
                 Fill="{Binding Current.AccentColor, Converter={StaticResource HexToGlow}}"/>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F00A0C11" Offset="0"/>
                    <GradientStop Color="#990A0C11" Offset="0.45"/>
                    <GradientStop Color="#200A0C11" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#990A0C11" Offset="0"/>
                    <GradientStop Color="#000A0C11" Offset="0.3"/>
                    <GradientStop Color="#400A0C11" Offset="0.55"/>
                    <GradientStop Color="#FA0A0C11" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Fill="{DynamicResource GrainBrush}"/>

        <!-- Top bar -->
        <Grid VerticalAlignment="Top" Margin="72,44,72,0">
            <StackPanel Orientation="Horizontal">
                <Grid Width="40" Height="40">
                    <Ellipse Fill="{DynamicResource AccentGlow}" Margin="-16"/>
                    <Border CornerRadius="12" Background="{DynamicResource LogoGradient}"/>
                    <Path Data="M 6.5,19 L 12,5 L 17.5,19 M 8.6,14 L 15.4,14" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Filters}" Margin="34,0,0,0" VerticalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TvFilter}">
                            <Border x:Name="Tab" CornerRadius="20" Padding="18,8" Margin="0,0,8,0" Background="Transparent">
                                <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" Foreground="#8CFFFFFF"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource EqualsMulti}">
                                            <Binding Path="Label"/>
                                            <Binding Path="DataContext.FilterLabel" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="Tab" Property="Background" Value="#F2FFFFFF"/>
                                    <Setter TargetName="Label" Property="Foreground" Value="#0A0C11"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="PadIcon" Text="&#xE7FC;" Style="{StaticResource Glyph}" FontSize="20" Foreground="#99FFFFFF" Margin="0,0,22,0"/>
                <TextBlock x:Name="ClockText" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
            </StackPanel>
        </Grid>

        <!-- Current game -->
        <StackPanel x:Name="Info" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="72,150,0,0" MaxWidth="820" DataContext="{Binding Current}">
            <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
            <Image MaxHeight="150" MaxWidth="560" HorizontalAlignment="Left" Stretch="Uniform"
                   c:ImageLoader.Source="{Binding LogoFullPath}" c:ImageLoader.DecodeWidth="640"
                   Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="64" FontWeight="Bold" Foreground="White"
                       TextWrapping="Wrap" LineHeight="70" Visibility="{Binding HasLogo, Converter={StaticResource InvBoolToVis}}"/>
            <TextBlock Text="{Binding MetaLine}" FontSize="17" Foreground="#CCFFFFFF" Margin="0,18,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Description}" FontSize="17" LineHeight="27" Foreground="#B3FFFFFF" Margin="0,16,0,0"
                       TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxHeight="82"/>
            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                <Border CornerRadius="10" Background="#26FFFFFF" Padding="14,7" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE823;" Style="{StaticResource Glyph}" FontSize="14" Foreground="White"/>
                        <TextBlock Text="{Binding PlayTimeText}" FontSize="15" Foreground="White" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="10" Background="#26FFFFFF" Padding="14,7" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource Glyph}" FontSize="14" Foreground="White"/>
                        <TextBlock Text="{Binding LastPlayedText}" FontSize="15" Foreground="White" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="10" Background="#33FF4F86" Padding="14,7" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB52;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{StaticResource Favorite}"/>
                        <TextBlock Text="Favori" FontSize="15" Foreground="White" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Carousel -->
        <Canvas x:Name="Track" VerticalAlignment="Bottom" Height="380" Margin="0,0,0,110">
            <ItemsControl x:Name="Strip" ItemsSource="{Binding Games}" Canvas.Top="20" Focusable="False">
                <ItemsControl.RenderTransform><TranslateTransform/></ItemsControl.RenderTransform>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Width" Value="216"/>
                        <Setter Property="Margin" Value="0,0,30,0"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,1"/>
                        <Setter Property="Opacity" Value="0.55"/>
                        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:Game}">
                        <Grid>
                            <Border Background="{DynamicResource CardShadowBrush}" Margin="-40,-28,-40,-50" Opacity="0.8"/>
                            <Border CornerRadius="14" Background="{Binding Name, Converter={StaticResource NameToBrush}}">
                                <c:AspectRatioBox Ratio="1.5">
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Foreground="White"
                                                   TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="16"/>
                                        <Border CornerRadius="14" c:ImageLoader.Source="{Binding CoverFullPath}" c:ImageLoader.DecodeWidth="260"/>
                                        <Border CornerRadius="14" BorderThickness="1" BorderBrush="#26FFFFFF"/>
                                    </Grid>
                                </c:AspectRatioBox>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- fixed selection frame: the strip slides beneath it -->
            <Grid x:Name="Selector" Canvas.Left="72" Canvas.Top="20" Width="216" Height="324" RenderTransformOrigin="0.5,1" IsHitTestVisible="False">
                <Grid.RenderTransform><ScaleTransform ScaleX="1.16" ScaleY="1.16"/></Grid.RenderTransform>
                <Border CornerRadius="16" BorderThickness="3" BorderBrush="White" Margin="-6"/>
                <Border CornerRadius="19" BorderThickness="3" BorderBrush="{DynamicResource AccentGradient}" Margin="-11" Opacity="0.85"/>
            </Grid>
        </Canvas>

        <!-- Hints -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="72,0,0,44">
            <Border Style="{StaticResource PadHint}" Background="#3DDC97"><TextBlock Text="A" FontWeight="Bold" Foreground="#0A0C11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Text="Jouer" Style="{StaticResource HintText}"/>
            <Border Style="{StaticResource PadHint}" Background="#FFB547"><TextBlock Text="Y" FontWeight="Bold" Foreground="#0A0C11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Text="Favori" Style="{StaticResource HintText}"/>
            <Border Style="{StaticResource PadHint}" Background="#45A6FF"><TextBlock Text="X" FontWeight="Bold" Foreground="#0A0C11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Text="Au hasard" Style="{StaticResource HintText}"/>
            <Border Style="{StaticResource PadHint}" Width="44" Background="#33FFFFFF"><TextBlock Text="LB" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <Border Style="{StaticResource PadHint}" Width="44" Background="#33FFFFFF"><TextBlock Text="RB" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Text="Catégorie" Style="{StaticResource HintText}"/>
            <Border Style="{StaticResource PadHint}" Background="#FF5A78"><TextBlock Text="B" FontWeight="Bold" Foreground="#0A0C11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Text="Quitter le mode TV" Style="{StaticResource HintText}"/>
        </StackPanel>
        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,72,48" FontSize="13" Foreground="#80FFFFFF"
                   Text="Clavier : ← → choisir · Entrée jouer · F favori · R hasard · Pg↑ Pg↓ catégorie · Échap quitter"/>
    </Grid>
</UserControl>

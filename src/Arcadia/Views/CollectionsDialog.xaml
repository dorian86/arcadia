<UserControl x:Class="Arcadia.Views.CollectionsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Arcadia.Controls"
             xmlns:vm="clr-namespace:Arcadia.ViewModels">
    <Border Style="{StaticResource DialogCard}" Width="480">
        <StackPanel>
            <Grid Width="52" Height="52" HorizontalAlignment="Left">
                <Ellipse Fill="{DynamicResource AccentSoft}"/>
                <TextBlock Text="&#xE8EC;" Style="{StaticResource Glyph}" FontSize="20" Foreground="{DynamicResource Accent}"/>
            </Grid>
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="20" Margin="0,18,0,0" TextWrapping="Wrap"/>

            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Choices}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CollectionChoice}">
                            <Border CornerRadius="10" Background="{StaticResource Surface2}" Padding="12,10" Margin="0,3">
                                <CheckBox Style="{StaticResource CheckBoxModern}" IsChecked="{Binding IsChecked}" IsThreeState="{Binding WasMixed}"
                                          Content="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontSize="14"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="Aucune collection pour l'instant : créez-en une ci-dessous." Style="{StaticResource BodyText}" Margin="0,12,0,0"
                       Visibility="{Binding HasChoices, Converter={StaticResource InvBoolToVis}}"/>

            <TextBlock Text="Nouvelle collection" Style="{StaticResource FieldLabel}" Margin="2,20,0,7"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewBox" Style="{StaticResource InputBox}" c:Ui.Placeholder="VR, Multijoueur, À finir…"
                         Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" KeyDown="NewBox_KeyDown"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Créer" c:Ui.Glyph="&#xE710;" Margin="8,0,0,0" Command="{Binding AddCommand}"/>
            </Grid>
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="12.5" Margin="2,8,0,0"
                       Visibility="{Binding Error, Converter={StaticResource NullToVis}}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                <Button Style="{StaticResource GhostButton}" Content="Annuler" Command="{Binding CancelCommand}"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Enregistrer" Margin="10,0,0,0" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

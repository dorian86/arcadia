<UserControl x:Class="Arcadia.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Arcadia.Controls"
             xmlns:vm="clr-namespace:Arcadia.ViewModels">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#CC141822"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="24,22"/>
        </Style>
        <Style x:Key="Kpi" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer c:SmoothScroll.IsEnabled="True" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="44,48,44,48">
            <TextBlock Text="Statistiques" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Votre activité de jeu mesurée par Arcadia." Style="{StaticResource PageSubtitle}" Margin="0,4,0,28"/>

            <!-- Year in review -->
            <Border CornerRadius="18" Margin="0,0,0,18" ClipToBounds="True" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                <Grid>
                    <Border Background="{DynamicResource AccentGradient}" Opacity="0.85"/>
                    <Ellipse Fill="#33FFFFFF" Width="320" Height="320" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,40,0"/>
                    <Ellipse Fill="#22FFFFFF" Width="200" Height="200" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-40,-110"/>
                    <Grid Margin="28,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding RecapTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Tes jeux les plus joués, tes heures, tes records et tes trophées de l'année." FontSize="13.5" Foreground="#E6FFFFFF" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" c:Ui.Glyph="&#xE768;" Content="Voir mon récap" Height="42" Padding="18,0"
                                Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OpenRecapCommand}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- KPIs -->
            <UniformGrid Columns="4" Margin="0,0,-16,0">
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <Grid>
                        <Ellipse Fill="{DynamicResource AccentGlow}" Width="160" Height="160" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-70,-70,0" Opacity="0.6"/>
                        <StackPanel>
                            <TextBlock Text="TEMPS DE JEU TOTAL" Style="{StaticResource Overline}"/>
                            <TextBlock Text="{Binding TotalTime}" Style="{StaticResource Kpi}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="SESSIONS" Style="{StaticResource Overline}"/>
                        <TextBlock Text="{Binding SessionCount}" Style="{StaticResource Kpi}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="SESSION MOYENNE" Style="{StaticResource Overline}"/>
                        <TextBlock Text="{Binding AverageSession}" Style="{StaticResource Kpi}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="JEUX LANCÉS" Style="{StaticResource Overline}"/>
                        <TextBlock Text="{Binding PlayedCount}" Style="{StaticResource Kpi}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Activity -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Activité des 12 dernières semaines" Style="{StaticResource SectionTitle}" FontSize="17"/>
                    <Grid Height="190" Margin="0,22,0,0">
                        <ItemsControl ItemsSource="{Binding Weeks}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BarItem}">
                                    <Grid Margin="6,0" ToolTip="{Binding Tooltip}" Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Value}" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <Border Grid.Row="1" VerticalAlignment="Bottom" CornerRadius="7,7,3,3" Background="{DynamicResource AccentGradient}"
                                                Height="{Binding Ratio, Converter={StaticResource RatioToLength}, ConverterParameter=130}"/>
                                        <TextBlock Grid.Row="2" Text="{Binding Label}" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Lancez vos jeux depuis Arcadia pour voir votre activité ici."
                                   Style="{StaticResource BodyText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasActivity, Converter={StaticResource InvBoolToVis}}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Most played -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Les plus joués" Style="{StaticResource SectionTitle}" FontSize="17" Margin="0,0,0,16"/>
                        <ItemsControl ItemsSource="{Binding TopGames}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BarItem}">
                                    <Button Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,0,10"
                                            Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OpenDetailCommand}" CommandParameter="{Binding Game}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="10" Padding="8" Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="36" Height="54" CornerRadius="6" Background="{Binding Game.Name, Converter={StaticResource NameToBrush}}">
                                                            <Border CornerRadius="6" c:ImageLoader.Source="{Binding Game.CoverFullPath}" c:ImageLoader.DecodeWidth="48"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                            <Grid Margin="0,8,0,0" Height="6">
                                                                <Border CornerRadius="3" Background="{StaticResource Surface3}"/>
                                                                <Border CornerRadius="3" Background="{DynamicResource AccentGradient}" HorizontalAlignment="Left"
                                                                        Width="{Binding Ratio, Converter={StaticResource RatioToLength}, ConverterParameter=420}"/>
                                                            </Grid>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Aucun temps de jeu enregistré pour l'instant." Style="{StaticResource BodyText}"
                                   Visibility="{Binding HasTopGames, Converter={StaticResource InvBoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Platforms -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Bibliothèque par plateforme" Style="{StaticResource SectionTitle}" FontSize="17" Margin="0,0,0,16"/>
                        <ItemsControl ItemsSource="{Binding Platforms}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BarItem}">
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimary}"/>
                                            <Grid Margin="0,7,0,0" Height="6">
                                                <Border CornerRadius="3" Background="{StaticResource Surface3}"/>
                                                <Border CornerRadius="3" Background="{DynamicResource AccentGradient}" HorizontalAlignment="Left"
                                                        Width="{Binding Ratio, Converter={StaticResource RatioToLength}, ConverterParameter=260}"/>
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                                   Margin="16,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Arcadia trophies -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Visibility="{Binding HasTrophies, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Trophées Arcadia" Style="{StaticResource SectionTitle}" FontSize="17"/>
                        <TextBlock Text="{Binding TrophyCount}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="12,0,0,1"/>
                        <TextBlock Text="{Binding TrophyTiers}" FontSize="12.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="16,0,0,2"/>
                    </StackPanel>
                    <TextBlock Text="Des étapes pour tous vos jeux, même ceux sans succès : temps de jeu, jeux terminés, séries de jours…" FontSize="12.5"
                               Foreground="{StaticResource TextMuted}" Margin="0,4,0,18"/>
                    <ItemsControl ItemsSource="{Binding Trophies}" Focusable="False" Margin="0,0,-12,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TrophyItem}">
                                <Border x:Name="Card" CornerRadius="12" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                        Padding="14,12" Margin="0,0,12,12" ToolTip="{Binding TierLabel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid x:Name="Medal" Width="46" Height="46" VerticalAlignment="Center">
                                            <Ellipse Fill="{Binding TierBrush}" Opacity="0.22"/>
                                            <Ellipse Stroke="{Binding TierBrush}" StrokeThickness="2"/>
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="18" Foreground="{Binding TierBrush}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            <Grid x:Name="Bar" Height="4" Margin="0,8,0,0" Visibility="Collapsed">
                                                <Border CornerRadius="2" Background="{StaticResource Surface3}"/>
                                                <Border CornerRadius="2" Background="{Binding TierBrush}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform><ScaleTransform ScaleX="{Binding Ratio}"/></Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                                        <Setter TargetName="Medal" Property="Opacity" Value="0.35"/>
                                        <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Card" Property="Background" Value="#80141822"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

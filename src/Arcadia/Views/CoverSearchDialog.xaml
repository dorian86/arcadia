<UserControl x:Class="Arcadia.Views.CoverSearchDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Arcadia.Controls">
    <Border Style="{StaticResource DialogCard}" Width="980" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="30,26,22,0">
                <StackPanel>
                    <TextBlock Text="Choisir une jaquette" Style="{StaticResource SectionTitle}" FontSize="22"/>
                    <TextBlock FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0">
                        <Run Text="Pour"/>
                        <Run Text="{Binding Game.Name, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                        <Run Text="— cliquez sur une image pour l'appliquer."/>
                    </TextBlock>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" c:Ui.Glyph="&#xE8BB;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding CloseCommand}" ToolTip="Fermer (Échap)"/>
            </Grid>

            <Grid Grid.Row="1" Margin="30,20,30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="QueryBox" Style="{StaticResource InputBox}" c:Ui.Glyph="&#xE721;" c:Ui.Placeholder="Nom du jeu…"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" KeyDown="QueryBox_KeyDown" FontSize="15" Height="44"/>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Rechercher" Height="44" Margin="10,0,0,0"
                        Command="{Binding SearchCommand}"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,18,0,0" MinHeight="380">
                <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" c:SmoothScroll.IsEnabled="True">
                    <ItemsControl ItemsSource="{Binding Results}" Margin="22,0,22,10" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="148" Margin="8,6,8,14" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                        Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" ToolTip="{Binding Title}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <StackPanel Background="Transparent">
                                                <Grid x:Name="Host" RenderTransformOrigin="0.5,0.5">
                                                    <c:ClipBorder CornerRadius="10" Background="{StaticResource Surface2}">
                                                        <c:AspectRatioBox Ratio="1.5">
                                                            <Grid>
                                                                <c:Spinner Width="18" Height="18" Foreground="{StaticResource TextMuted}"/>
                                                                <Image x:Name="Thumb" Stretch="UniformToFill" c:ImageLoader.Source="{Binding ThumbUrl}" c:ImageLoader.DecodeWidth="240"/>
                                                                <Border x:Name="Ring" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent"/>
                                                                <Border CornerRadius="6" Background="#CC0A0C11" Padding="6,2" Margin="7"
                                                                        HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                                    <TextBlock Text="{Binding Source}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                                </Border>
                                                            </Grid>
                                                        </c:AspectRatioBox>
                                                    </c:ClipBorder>
                                                </Grid>
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis" Margin="2,9,2,0"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource TextMuted}"
                                                           TextTrimming="CharacterEllipsis" Margin="2,1,2,0"
                                                           Visibility="{Binding Subtitle, Converter={StaticResource NullToVis}}"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    <Setter TargetName="Host" Property="RenderTransform">
                                                        <Setter.Value><ScaleTransform ScaleX="1.03" ScaleY="1.03"/></Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- States -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                    <c:Spinner Width="34" Height="34"/>
                    <TextBlock Text="Recherche des jaquettes…" Foreground="{StaticResource TextSecondary}" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" TextAlignment="Center" MaxWidth="460"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Status, Converter={StaticResource NullToVis}}"/>
                <Grid Background="#B30A0C11" Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <c:Spinner Width="34" Height="34"/>
                        <TextBlock Text="Téléchargement de l'image…" Foreground="{StaticResource TextPrimary}" Margin="0,16,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="3" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="30,16" CornerRadius="0,0,18,18"
                    Background="{StaticResource Bg1}">
                <Grid>
                    <CheckBox Style="{StaticResource CheckBoxModern}" IsChecked="{Binding UpdateInfo}" VerticalAlignment="Center"
                              Content="Mettre aussi à jour le nom et les informations du jeu"
                              Visibility="{Binding ShowUpdateInfo, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Content="Importer depuis mon PC…" c:Ui.Glyph="&#xE8B5;"
                                Command="{Binding ImportFileCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Content="Annuler" Margin="8,0,0,0" Command="{Binding CloseCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

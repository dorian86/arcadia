<UserControl x:Class="Arcadia.Views.SelectionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Arcadia.Controls"
             VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26"
             Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
    <!-- Actions on the selected games (shown on every page with game cards) -->
    <Grid>
        <Border Background="{DynamicResource PanelShadowBrush}" Margin="-50,-30,-50,-56" Opacity="0.9" IsHitTestVisible="False"/>
        <Border CornerRadius="16" Background="{StaticResource Surface2}" BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Border CornerRadius="10" Background="{DynamicResource AccentGradient}" Padding="14,0" Height="40">
                    <TextBlock VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold">
                        <Run Text="{Binding SelectedCount, Mode=OneWay}"/><Run Text=" sélectionné(s)"/>
                    </TextBlock>
                </Border>
                <Button Style="{StaticResource GhostButton}" c:Ui.Glyph="&#xEB51;" Content="Favoris" Margin="8,0,0,0" Command="{Binding BulkFavoriteCommand}"/>
                <Button Style="{StaticResource GhostButton}" c:Ui.Glyph="&#xE8EC;" Content="Collections…" Command="{Binding BulkCollectionsCommand}"/>
                <Button Style="{StaticResource GhostButton}" c:Ui.Glyph="&#xED1A;" Content="Masquer" Command="{Binding BulkHideCommand}"/>
                <Button Style="{StaticResource GhostButton}" c:Ui.Glyph="&#xE74D;" Content="Retirer" Command="{Binding BulkRemoveCommand}"/>
                <Border Width="1" Background="{StaticResource StrokeStrong}" Margin="6,8"/>
                <Button Style="{StaticResource GhostButton}" Content="Tout" Command="{Binding SelectAllCommand}" ToolTip="Tout sélectionner (Ctrl+A)"/>
                <Button Style="{StaticResource IconButton}" c:Ui.Glyph="&#xE711;" FontSize="12" Command="{Binding ClearSelectionCommand}" ToolTip="Annuler la sélection (Échap)"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

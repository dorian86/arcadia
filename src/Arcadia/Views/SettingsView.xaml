<UserControl x:Class="Arcadia.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Arcadia.Controls"
             xmlns:s="clr-namespace:Arcadia.Services"
             xmlns:vm="clr-namespace:Arcadia.ViewModels">
    <UserControl.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#CC141822"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="26,22"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style x:Key="CardHeader" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Stroke}"/>
            <Setter Property="Margin" Value="0,18"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer c:SmoothScroll.IsEnabled="True" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="44,48,44,48" MaxWidth="920" HorizontalAlignment="Left">
            <TextBlock Text="Paramètres" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Personnalisez Arcadia." Style="{StaticResource PageSubtitle}" Margin="0,4,0,30"/>

            <!-- Appearance -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Apparence" Style="{StaticResource CardHeader}"/>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowTitle}">
                                <Run Text="Thème de l'interface :"/>
                                <Run Text="{Binding CurrentTheme.Name, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock Text="Arcadia, ou une interface dans l'esprit des menus Wii, Wii U, Switch, PS3, PS4 et PS5." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" c:Ui.Glyph="&#xE790;" Content="Choisir un thème…"
                                Command="{Binding OpenThemesCommand}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>

                    <!-- Wallpaper of the default interface -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- preview -->
                        <Border Width="128" Height="72" CornerRadius="10" Margin="0,0,18,0" ClipToBounds="True"
                                Background="{StaticResource Surface2}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="&#xEB9F;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border CornerRadius="9" c:ImageLoader.Source="{Binding WallpaperPath}" c:ImageLoader.DecodeWidth="260"
                                        Visibility="{Binding HasWallpaper, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Fond d'écran" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Une image de votre choix derrière l'interface Arcadia (accueil, bibliothèque, statistiques…). Elle est copiée dans Arcadia : vous pouvez déplacer ou supprimer l'originale."
                                       Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                            <Button Style="{StaticResource SecondaryButton}" c:Ui.Glyph="&#xEB9F;" Content="Choisir une image…"
                                    Command="{Binding ChooseWallpaperCommand}" IsEnabled="{Binding IsWallpaperBusy, Converter={StaticResource InvertBool}}"/>
                            <Button Style="{StaticResource GhostButton}" Content="Retirer" Margin="8,0,0,0"
                                    Command="{Binding RemoveWallpaperCommand}" Visibility="{Binding HasWallpaper, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="146,14,0,0" Visibility="{Binding HasWallpaper, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Assombrir" Style="{StaticResource RowHint}" VerticalAlignment="Center" Width="90" Margin="0"/>
                            <Slider Grid.Column="1" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="90" Width="300" Margin="0,0,14,0"
                                    Value="{Binding Settings.WallpaperDim}" ToolTip="Plus l'image est assombrie, plus les textes sont lisibles"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource RowHint}" VerticalAlignment="Center" Margin="0"
                                       Text="{Binding Settings.WallpaperDim, StringFormat={}{0:0} %}"/>
                        </Grid>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.WallpaperBlur}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Flouter l'image" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Un flou doux met les jaquettes en valeur." Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <TextBlock Text="Couleur d'accent" Style="{StaticResource RowTitle}" Margin="0,4,0,12"/>
                    <ItemsControl ItemsSource="{Binding AccentPresets}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type s:AccentPreset}">
                                <Button Margin="0,0,14,8" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="{Binding Label}"
                                        Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SelectAccentCommand}" CommandParameter="{Binding Name}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <StackPanel Background="Transparent">
                                                <Grid Width="58" Height="58">
                                                    <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2.5"/>
                                                    <Ellipse Margin="6">
                                                        <Ellipse.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="{Binding A}" Offset="0"/>
                                                                <GradientStop Color="{Binding B}" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <TextBlock x:Name="Check" Text="&#xE73E;" Style="{StaticResource Glyph}" Foreground="White" FontSize="16" Visibility="Collapsed"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource EqualsMulti}">
                                                            <Binding Path="Name"/>
                                                            <Binding Source="{x:Static vm:MainViewModel.Instance}" Path="Settings.AccentPreset"/>
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter TargetName="Ring" Property="Stroke" Value="White"/>
                                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Ring" Property="Stroke" Value="#66FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.DynamicColors}">
                        <StackPanel>
                            <TextBlock Text="Couleurs dynamiques" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="L'arrière-plan s'illumine avec les couleurs de la jaquette du jeu affiché." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.AutoPlayTrailers}">
                        <StackPanel>
                            <TextBlock Text="Bandes-annonces en arrière-plan" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="La bande-annonce Steam du jeu se lance en sourdine derrière sa fiche et en mode TV (téléchargée une fois, puis gardée en cache)." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Sound -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Son" Style="{StaticResource CardHeader}" Margin="0,0,0,18"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.SoundEnabled}">
                        <StackPanel>
                            <TextBlock Text="Effets sonores" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Sons discrets lors de la navigation, du lancement d'un jeu et en mode TV." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                    </CheckBox>
                    <Grid Margin="0,16,0,0" IsEnabled="{Binding Settings.SoundEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE767;" Style="{StaticResource Glyph}" Foreground="{StaticResource TextMuted}"/>
                        <Slider Grid.Column="1" Style="{StaticResource ModernSlider}" Minimum="0.05" Maximum="1" Margin="14,0" MaxWidth="360" HorizontalAlignment="Left" Width="360"
                                Value="{Binding Settings.SoundVolume}"/>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Tester" c:Ui.Glyph="&#xE768;" Command="{Binding TestSoundCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Behaviour -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Comportement" Style="{StaticResource CardHeader}" Margin="0,0,0,18"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.MinimizeOnLaunch}">
                        <StackPanel>
                            <TextBlock Text="Réduire Arcadia au lancement d'un jeu" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="La fenêtre revient automatiquement quand vous quittez le jeu." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.AutoFetchMetadata}">
                        <StackPanel>
                            <TextBlock Text="Rechercher automatiquement les jaquettes et les informations" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="À l'ajout d'un jeu, Arcadia l'identifie et télécharge sa jaquette officielle (Steam, Wikipédia, SteamGridDB)." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.AutoDetectGames}">
                        <StackPanel>
                            <TextBlock Text="Signaler les nouveaux jeux installés" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Au démarrage, Arcadia vérifie Steam, Epic, GOG, Ubisoft Connect et Xbox et vous propose les jeux qui manquent." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Steam & emulation -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Temps de jeu et émulation" Style="{StaticResource CardHeader}" Margin="0,0,0,18"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ImportSteamPlaytime}" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="Importer le temps de jeu Steam et Epic Games" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Au démarrage, Arcadia reprend le temps de jeu enregistré sur ce PC par Steam (avec la date de dernière partie) et par le launcher Epic Games." Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </CheckBox>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Importer maintenant" c:Ui.Glyph="&#xE896;" Command="{Binding ImportSteamPlaytimeCommand}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.AchievementPopups}">
                        <StackPanel>
                            <TextBlock Text="Afficher les succès débloqués pendant le jeu" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Pour les jeux lancés sans leur launcher officiel qui enregistrent leurs succès sur ce PC : Arcadia les suit en direct et affiche « Succès débloqué » en bas à droite de l'écran, par-dessus le jeu (en fenêtre ou en plein écran fenêtré)." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.TrackOutsidePlaytime}">
                        <StackPanel>
                            <TextBlock Text="Mesurer le temps de jeu des jeux lancés hors d'Arcadia" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Tant qu'Arcadia est ouvert (même réduit dans la zone de notification), il reconnaît les jeux de votre bibliothèque lancés depuis Steam, Epic, l'EA app, Battle.net, Ubisoft, Xbox ou un raccourci, et ajoute leur temps de jeu. Xbox, EA, Ubisoft, Battle.net et Riot ne gardent pas ce temps sur votre PC : c'est la seule façon de le connaître." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Bibliothèque d'émulation" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Ryujinx, Yuzu, Cemu, Dolphin, PCSX2… : une fiche par jeu à partir de vos dossiers de ROM, ajoutée automatiquement." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Configurer" c:Ui.Glyph="&#xE713;" Command="{Binding ManageEmulatorsCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- System -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Système" Style="{StaticResource CardHeader}" Margin="0,0,0,18"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowTrayIcon}">
                        <StackPanel>
                            <TextBlock Text="Icône dans la zone de notification" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Accès rapide près de l'horloge : ouvrir Arcadia, lancer un jeu récent, mode TV." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.CloseToTray}" IsEnabled="{Binding Settings.ShowTrayIcon}">
                        <StackPanel>
                            <TextBlock Text="Garder Arcadia ouvert à la fermeture" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Le bouton ✕ range Arcadia dans la zone de notification au lieu de le quitter." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.StartWithWindows}">
                        <StackPanel>
                            <TextBlock Text="Lancer avec Windows" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Arcadia démarre discrètement dans la zone de notification à l'ouverture de session." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Installer Arcadia sur ce PC" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="{Binding InstallStatus}" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Installer" c:Ui.Glyph="&#xE896;"
                                Command="{Binding InstallCommand}" Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Artwork -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Jaquettes et images" Style="{StaticResource CardHeader}"/>
                    <TextBlock Style="{StaticResource RowHint}" Margin="0,6,0,18"
                               Text="Les images viennent du Steam Store (sans compte) puis de Wikipédia. Une clé SteamGridDB gratuite (facultative) couvre davantage de jeux, y compris hors Steam."/>
                    <TextBlock Text="Clé API SteamGridDB (facultative)" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputBox}" c:Ui.Glyph="&#xE192;" c:Ui.Placeholder="Collez votre clé ici"
                                 Text="{Binding Settings.SteamGridDbApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Obtenir une clé" c:Ui.Glyph="&#xE8A7;" Margin="10,0,0,0"
                                Command="{Binding OpenUrlCommand}" CommandParameter="https://www.steamgriddb.com/profile/preferences/api"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}" Margin="0,22,0,18"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Rechercher les jaquettes manquantes" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Les jeux sans image officielle reçoivent une jaquette générée par Arcadia. Relancez la recherche après avoir ajouté une clé SteamGridDB." Style="{StaticResource RowHint}"/>
                            <TextBlock Style="{StaticResource RowHint}" Foreground="{DynamicResource Accent}"><Run Text="{Binding MissingArtCount, Mode=OneWay}"/><Run Text=" jeu(x) sans jaquette officielle"/></TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Lancer la recherche" c:Ui.Glyph="&#xE72C;"
                                Command="{Binding RetryMissingArtCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Library -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Bibliothèque" Style="{StaticResource CardHeader}" Margin="0,0,0,18"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Assistant de démarrage" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Détection des jeux installés, choix de l'interface, de la couleur et du fond d'écran." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" c:Ui.Glyph="&#xE768;" Content="Relancer l'assistant"
                                Command="{Binding OpenOnboardingCommand}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Détecter les jeux installés" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Steam, Epic Games, GOG, Ubisoft Connect, Xbox, EA app, Battle.net et Riot Games." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Analyser" c:Ui.Glyph="&#xE721;" Command="{Binding ScanPcCommand}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ImportOwnedGames}" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="Ajouter aussi les jeux non installés" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="Les jeux de vos bibliothèques Steam (famille comprise) et Epic Games que vous n'avez pas installés, avec leurs heures de jeu. Ils restent à part, dans « Tous les jeux → Non installés », et rejoignent les autres dès qu'ils sont installés." Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </CheckBox>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Synchroniser" c:Ui.Glyph="&#xE895;" Command="{Binding SyncOwnedGamesCommand}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Jeux en double" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Le même jeu ajouté deux fois (deux dossiers, un raccourci et le launcher…) : fusionnez les entrées sans perdre le temps de jeu." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Rechercher" c:Ui.Glyph="&#xE8C8;" Command="{Binding ShowDuplicatesCommand}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Vérifier les chemins des jeux" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Signale les jeux déplacés, désinstallés ou situés sur un disque déconnecté." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Vérifier" c:Ui.Glyph="&#xE73E;" Command="{Binding CheckPathsCommand}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Dossier des données" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="{Binding DataFolder}" Style="{StaticResource RowHint}" FontFamily="Cascadia Mono, Consolas"/>
                            <TextBlock Text="Bibliothèque (library.json), images en cache et copie de vos raccourcis. Vos jeux ne sont jamais modifiés."
                                       Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Ouvrir" c:Ui.Glyph="&#xE838;" Command="{Binding OpenDataFolderCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Mises à jour" Style="{StaticResource CardHeader}"/>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource RowTitle}">
                                <Run Text="Version installée :"/>
                                <Run Text="{Binding AppVersion, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" c:Ui.Glyph="&#xE895;" Content="Rechercher une mise à jour"
                                Command="{Binding CheckUpdatesCommand}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.AutoCheckUpdates}">
                        <StackPanel>
                            <TextBlock Text="Vérifier au démarrage" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="Arcadia vous prévient quand une nouvelle version est publiée ; elle s'installe en un clic, sans toucher à votre bibliothèque." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="52" Height="52">
                        <Ellipse Fill="{DynamicResource AccentGlow}" Margin="-20"/>
                        <Border CornerRadius="14" Background="{DynamicResource LogoGradient}"/>
                        <Path Data="M 6.5,19 L 12,5 L 17.5,19 M 8.6,14 L 15.4,14" Stroke="White" StrokeThickness="2.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"

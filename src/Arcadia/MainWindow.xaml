<Window x:Class="Arcadia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Arcadia.Controls"
        xmlns:v="clr-namespace:Arcadia.Views"
        xmlns:vm="clr-namespace:Arcadia.ViewModels"
        Title="Arcadia" Width="1480" Height="920" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg0}" Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource TextFont}" FontSize="14"
        Icon="pack://application:,,,/Arcadia;component/Assets/Arcadia.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        AllowDrop="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================ Ambient background ============================ -->
        <Grid Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <!-- custom wallpaper (Settings > Appearance), darkened so that text stays readable -->
            <Grid Visibility="{Binding HasWallpaper, Converter={StaticResource BoolToVis}}">
                <Border c:ImageLoader.Source="{Binding WallpaperPath}" c:ImageLoader.DecodeWidth="2560"/>
                <Rectangle Fill="{StaticResource Bg0}" Opacity="{Binding WallpaperDimOpacity}"/>
                <!-- a little darker behind the page titles -->
                <Rectangle Height="260" VerticalAlignment="Top">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#990A0C11" Offset="0"/>
                            <GradientStop Color="#000A0C11" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
            <Ellipse x:Name="AmbientTop" Width="1400" Height="1000" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-560,-420,0" Opacity="0.30"/>
            <Ellipse x:Name="AmbientBottom" Width="1100" Height="900" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="-360,0,0,-620" Opacity="0.16"/>
            <Rectangle Fill="{DynamicResource GrainBrush}"/>
        </Grid>

        <!-- ============================ Sidebar ============================ -->
        <Border Grid.Column="0" Background="#D90E1118" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,22,0,24">
                    <Grid Width="34" Height="34">
                        <Ellipse Fill="{DynamicResource AccentGlow}" Margin="-14" Opacity="0.8"/>
                        <Border CornerRadius="10" Background="{DynamicResource LogoGradient}"/>
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="#40FFFFFF"/>
                        <Path Data="M 6.5,19 L 12,5 L 17.5,19 M 8.6,14 L 15.4,14" Stroke="White" StrokeThickness="2.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="24" Height="24" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ARCADIA" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Game Launcher" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,-1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Bottom actions -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
                    <Border Height="1" Background="{StaticResource Stroke}" Margin="4,0,4,12"/>
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,10" Visibility="{Binding IsFetchingMetadata, Converter={StaticResource BoolToVis}}">
                        <c:Spinner Width="14" Height="14"/>
                        <TextBlock Text="Recherche des jaquettes…" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,10" Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
                        <c:Spinner Width="14" Height="14"/>
                        <TextBlock Text="Importation en cours…" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" c:Ui.Glyph="&#xE710;" Content="Ajouter des jeux" Height="42"
                            Click="AddButton_Click" ToolTip="Fichiers, dossier, ou détection des jeux installés">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Détecter les jeux installés…" FontWeight="SemiBold" Command="{Binding ScanPcCommand}" InputGestureText="Steam, Epic…">
                                    <MenuItem.Icon><TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Ajouter des fichiers…" Command="{Binding AddGamesCommand}" InputGestureText="Ctrl+O">
                                    <MenuItem.Icon><TextBlock Text="&#xE8E5;" Style="{StaticResource Glyph}" FontSize="13"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Chercher dans un dossier…" Command="{Binding ImportFolderCommand}">
                                    <MenuItem.Icon><TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="13"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" c:Ui.Glyph="&#xE790;" Content="Thèmes" Height="38" FontSize="13" Margin="0,8,0,0"
                            Command="{Binding OpenThemesCommand}" ToolTip="Changer l'interface : Wii, Switch, PS5…"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource GhostButton}" c:Ui.Glyph="&#xE7F4;" Content="Mode TV" Height="38" FontSize="13"
                                Command="{Binding EnterTvModeCommand}" ToolTip="Interface plein écran pour manette (F11, ou Start + Back)"/>
                        <Button Grid.Column="2" Height="38" FontSize="13" Content="Réglages" c:Ui.Glyph="&#xE713;"
                                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Section.Settings}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Section}" Value="{x:Static vm:Section.Settings}">
                                            <Setter Property="Background" Value="{StaticResource Surface2}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" c:SmoothScroll.IsEnabled="True">
                    <StackPanel Margin="16,0,16,8">
                        <TextBlock Text="BIBLIOTHÈQUE" Style="{StaticResource Overline}" Margin="14,0,0,8"/>
                        <RadioButton Style="{StaticResource NavItem}" c:Ui.Glyph="&#xE80F;" Content="Accueil"
                                     IsChecked="{Binding Section, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static vm:Section.Home}}"/>
                        <RadioButton Style="{StaticResource NavItem}" c:Ui.Glyph="&#xE8F1;" Content="Tous les jeux"
                                     Tag="{Binding AllCount, Converter={StaticResource CountToBadge}}"
                                     IsChecked="{Binding Section, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static vm:Section.All}}"/>
                        <RadioButton Style="{StaticResource NavItem}" c:Ui.Glyph="&#xEB51;" Content="Favoris"
                                     Tag="{Binding FavoritesCount, Converter={StaticResource CountToBadge}}"
                                     IsChecked="{Binding Section, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static vm:Section.Favorites}}"/>
                        <RadioButton Style="{StaticResource NavItem}" c:Ui.Glyph="&#xE81C;" Content="Récemment joués"
                                     Tag="{Binding RecentCount, Converter={StaticResource CountToBadge}}"
                                     IsChecked="{Binding Section, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static vm:Section.Recent}}"/>
                        <RadioButton Style="{StaticResource NavItem}" c:Ui.Glyph="&#xE9D9;" Content="Statistiques"
                                     IsChecked="{Binding Section, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static vm:Section.Stats}}"/>

                        <!-- Collections -->
                        <Grid Margin="14,24,4,6">
                            <TextBlock Text="COLLECTIONS" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconButton}" c:Ui.Glyph="&#xE710;" Width="26" Height="26" FontSize="11" c:Ui.CornerRadius="7"
                                    HorizontalAlignment="Right" Command="{Binding NewCollectionCommand}" ToolTip="Nouvelle collection"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding CollectionItems}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NavEntry}">
                                    <Button Style="{StaticResource NavButton}" c:Ui.Glyph="{Binding Glyph}" Content="{Binding Label}" Tag="{Binding Badge}"
                                            c:Ui.IsActive="{Binding IsActive}"
                                            Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OpenCollectionCommand}" CommandParameter="{Binding Key}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Renommer…"
                                                          Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=RenameCollectionCommand}" CommandParameter="{Binding Key}">
                                                    <MenuItem.Icon><TextBlock Text="&#xE8AC;" Style="{StaticResource Glyph}" FontSize="13"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Supprimer la collection" Style="{StaticResource DangerMenuItem}"
                                                          Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=DeleteCollectionCommand}" CommandParameter="{Binding Key}">
                                                    <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{StaticResource Danger}"/></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Créez des collections : VR, Émulation, Multijoueur…" FontSize="12" Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap" Margin="14,2,8,0"
                                   Visibility="{Binding CollectionItems.Count, Converter={StaticResource InvCountToVis}}"/>

                        <!-- Platforms -->
                        <TextBlock Text="PLATEFORMES" Style="{StaticResource Overline}" Margin="14,24,0,6"
                                   Visibility="{Binding PlatformItems.Count, Converter={StaticResource CountToVis}}"/>
                        <ItemsControl ItemsSource="{Binding PlatformItems}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NavEntry}">
                                    <Button Style="{StaticResource NavButton}" c:Ui.Glyph="{Binding Glyph}" Content="{Binding Label}" Tag="{Binding Badge}"
                                            c:Ui.IsActive="{Binding IsActive}"
                                            Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OpenPlatformCommand}" CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Progress -->
                        <TextBlock Text="PROGRESSION" Style="{StaticResource Overline}" Margin="14,24,0,6"
                                   Visibility="{Binding StatusItems.Count, Converter={StaticResource CountToVis}}"/>
                        <ItemsControl ItemsSource="{Binding StatusItems}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NavEntry}">
                                    <Button Style="{StaticResource NavButton}" c:Ui.Glyph="{Binding Glyph}" Content="{Binding Label}" Tag="{Binding Badge}"
                                            c:Ui.IsActive="{Binding IsActive}"
                                            Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OpenStatusCommand}" CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Maintenance -->
                        <StackPanel Margin="0,14,0,0">
                            <RadioButton Style="{StaticResource NavItem}" c:Ui.Glyph="&#xE7BA;" Content="Introuvables"
                                         Tag="{Binding MissingCount, Converter={StaticResource CountToBadge}}"
                                         Visibility="{Binding MissingCount, Converter={StaticResource CountToVis}}"
                                         IsChecked="{Binding Section, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static vm:Section.Missing}}"/>
                            <RadioButton Style="{StaticResource NavItem}" c:Ui.Glyph="&#xED1A;" Content="Masqués"
                                         Tag="{Binding HiddenCount, Converter={StaticResource CountToBadge}}"
                                         Visibility="{Binding HiddenCount, Converter={StaticResource CountToVis}}"
                                         IsChecked="{Binding Section, Converter={StaticResource EqualsToBool}, ConverterParameter={x:Static vm:Section.Hidden}}"/>
                        </StackPanel>

                        <!-- Recently played -->
                        <StackPanel Visibility="{Binding SidebarRecent.Count, Converter={StaticResource CountToVis}}">
                            <TextBlock Text="JOUÉS RÉCEMMENT" Style="{StaticResource Overline}" Margin="14,24,0,8"/>
                            <ItemsControl ItemsSource="{Binding SidebarRecent}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OpenDetailCommand}" CommandParameter="{Binding}"
                                                c:GameMenu.Enable="True" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" CornerRadius="9" Padding="10,7" Background="Transparent" Margin="0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="26" Height="26" CornerRadius="6" Background="{Binding Name, Converter={StaticResource NameToBrush}}">
                                                                <Border CornerRadius="6" c:ImageLoader.Source="{Binding CoverFullPath}" c:ImageLoader.DecodeWidth="40"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock x:Name="T" Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding LastPlayedText}" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}"/>
                                                            <Setter TargetName="T" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============================ Content ============================ -->
        <Grid Grid.Column="1" x:Name="ContentRoot" ClipToBounds="True">
            <Grid x:Name="PageHost">
                <v:HomeView x:Name="HomePage"
                            Visibility="{Binding Section, Converter={StaticResource EqualsToVis}, ConverterParameter={x:Static vm:Section.Home}}"/>
                <v:LibraryView x:Name="LibraryPage"
                               Visibility="{Binding IsLibrarySection, Converter={StaticResource BoolToVis}}"/>
                <v:StatsView x:Name="StatsPage" DataContext="{Binding Stats}"
                             Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToVis}, ConverterParameter={x:Static vm:Section.Stats}}"/>
                <v:SettingsView x:Name="SettingsPage"
                                Visibility="{Binding Section, Converter={StaticResource EqualsToVis}, ConverterParameter={x:Static vm:Section.Settings}}"/>
            </Grid>

            <v:GameDetailView x:Name="DetailPage" Visibility="Collapsed" DataContext="{x:Null}"/>
        </Grid>

        <!-- Back to the console theme (classic pages opened from a theme) -->
        <Button Grid.Column="1" Panel.ZIndex="6" Style="{StaticResource PrimaryButton}" c:Ui.Glyph="&#xE72B;" Content="{Binding ReturnToShellText}"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" Height="34" FontSize="13" Padding="16,0"
                WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding ReturnToShellCommand}"
                Visibility="{Binding ShowReturnToShell, Converter={StaticResource BoolToVis}}"/>

        <!-- Console-style theme (Wii, Switch, PS5…): covers the whole window -->
        <ContentControl x:Name="ShellHost" Grid.ColumnSpan="2" Panel.ZIndex="12" Visibility="Collapsed" Focusable="False"/>
        <!-- game page of the console themes (over the theme, same layer) -->
        <ContentControl x:Name="SheetHost" Grid.ColumnSpan="2" Panel.ZIndex="12" Visibility="Collapsed" Focusable="False"/>

        <!-- Window buttons -->
        <StackPanel x:Name="CaptionButtons" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="13">
            <Button Style="{StaticResource CaptionButton}" c:Ui.Glyph="&#xE921;" Click="Minimize_Click" ToolTip="Réduire"/>
            <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" c:Ui.Glyph="&#xE922;" Click="Maximize_Click" ToolTip="Agrandir"/>
            <Button Style="{StaticResource CloseCaptionButton}" c:Ui.Glyph="&#xE8BB;" Click="Close_Click" ToolTip="Fermer"/>
        </StackPanel>

        <!-- TV mode -->
        <v:TvModeView x:Name="TvPage" Grid.ColumnSpan="2" Panel.ZIndex="15" Visibility="Collapsed" DataContext="{Binding Tv}"/>

        <!-- Drop overlay -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="18" IsHitTestVisible="False"
              Visibility="{Binding IsDragOver, Converter={StaticResource BoolToVis}}">
            <Border Background="#D90A0C11"/>
            <Grid Margin="36">
                <Rectangle RadiusX="26" RadiusY="26" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeDashArray="5 4" Fill="#0D7C6CFF"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="96" Height="96" HorizontalAlignment="Center">
                        <Ellipse Fill="{DynamicResource AccentGlow}" Margin="-30"/>
                        <Ellipse Fill="{DynamicResource AccentGradient}" Margin="16"/>
                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="28" Foreground="White"/>
                    </Grid>
                    <TextBlock Text="Déposez vos jeux ici" Style="{StaticResource PageTitle}" HorizontalAlignment="Center" Margin="0,26,0,0"/>
                    <TextBlock Text="Raccourcis (.lnk, .url), exécutables (.exe) ou dossiers entiers" Style="{StaticResource PageSubtitle}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Dialogs -->
        <ItemsControl Grid.ColumnSpan="2" Panel.ZIndex="20" ItemsSource="{Binding Dialogs}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Border Background="{StaticResource Backdrop}"/>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                            <Border Background="{DynamicResource PanelShadowBrush}" Margin="-60,-44,-60,-76" Opacity="0.9" IsHitTestVisible="False"/>
                            <ContentPresenter Content="{Binding}"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- "Trophy obtained" banner (above every interface, console themes included) -->
        <Border x:Name="TrophyBannerView" Grid.ColumnSpan="2" Panel.ZIndex="24" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="18" Padding="14,12,28,12" MinWidth="360"
                Background="{DynamicResource ToastBg}" BorderBrush="{Binding TierBrush}" BorderThickness="1.5">
            <Border.RenderTransform><TranslateTransform Y="-140"/></Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.55" Color="Black"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Grid Width="54" Height="54">
                    <Ellipse Fill="{Binding TierBrush}" Opacity="0.25"/>
                    <Ellipse Stroke="{Binding TierBrush}" StrokeThickness="2.5"/>
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="21" Foreground="{Binding TierBrush}"/>
                </Grid>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="{Binding TierBrush}">
                        <Run Text="TROPHÉE OBTENU  ·"/>
                        <Run Text="{Binding TierLabel, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource ToastFg}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{DynamicResource ToastMuted}" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Toasts -->
        <ItemsControl x:Name="ToastHost" Grid.Column="1" Panel.ZIndex="25" ItemsSource="{Binding Toasts}" ItemTemplate="{StaticResource ToastTemplate}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,26" Focusable="False"/>
    </Grid>
</Window>

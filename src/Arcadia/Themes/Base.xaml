<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Arcadia.Converters"
                    xmlns:c="clr-namespace:Arcadia.Controls">

    <!-- ======================= Palette ======================= -->
    <Color x:Key="Bg0Color">#0A0C11</Color>
    <Color x:Key="Bg1Color">#0E1118</Color>
    <Color x:Key="SurfaceColor">#141822</Color>
    <Color x:Key="Surface2Color">#1A1F2B</Color>
    <Color x:Key="Surface3Color">#232938</Color>
    <Color x:Key="StrokeColor">#222838</Color>
    <Color x:Key="StrokeStrongColor">#2F3749</Color>
    <Color x:Key="TextPrimaryColor">#F2F4F8</Color>
    <Color x:Key="TextSecondaryColor">#A3ABBC</Color>
    <Color x:Key="TextMutedColor">#6C7487</Color>
    <Color x:Key="AccentColor">#7C6CFF</Color>
    <Color x:Key="Accent2Color">#45A6FF</Color>
    <Color x:Key="DangerColor">#FF5A78</Color>
    <Color x:Key="SuccessColor">#3DDC97</Color>
    <Color x:Key="WarningColor">#FFB547</Color>
    <Color x:Key="FavoriteColor">#FF4F86</Color>

    <SolidColorBrush x:Key="Bg0" Color="{StaticResource Bg0Color}"/>
    <SolidColorBrush x:Key="Bg1" Color="{StaticResource Bg1Color}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="Surface3" Color="{StaticResource Surface3Color}"/>
    <SolidColorBrush x:Key="Stroke" Color="{StaticResource StrokeColor}"/>
    <SolidColorBrush x:Key="StrokeStrong" Color="{StaticResource StrokeStrongColor}"/>
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>

    <!-- notifications (toasts, trophy banner): restyled by the window in the console themes -->
    <SolidColorBrush x:Key="ToastBg" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="ToastStroke" Color="{StaticResource StrokeStrongColor}"/>
    <SolidColorBrush x:Key="ToastFg" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="ToastMuted" Color="{StaticResource TextSecondaryColor}"/>
    <CornerRadius x:Key="ToastRadius">12</CornerRadius>
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="Accent2" Color="{StaticResource Accent2Color}"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#297C6CFF"/>
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#26FF5A78"/>
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningSoft" Color="#1FFFB547"/>
    <SolidColorBrush x:Key="Favorite" Color="{StaticResource FavoriteColor}"/>
    <SolidColorBrush x:Key="Backdrop" Color="#C2050609"/>
    <SolidColorBrush x:Key="HairlineLight" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="HairlineHover" Color="#40FFFFFF"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B6CFF" Offset="0"/>
        <GradientStop Color="#5C7CFF" Offset="0.55"/>
        <GradientStop Color="#3FA8FF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9D7BFF" Offset="0"/>
        <GradientStop Color="#5B6CFF" Offset="0.5"/>
        <GradientStop Color="#2FB5FF" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="AccentGlow">
        <GradientStop Color="#B06C7CFF" Offset="0"/>
        <GradientStop Color="#406C7CFF" Offset="0.55"/>
        <GradientStop Color="#006C7CFF" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="ShineBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00FFFFFF" Offset="0.35"/>
        <GradientStop Color="#2EFFFFFF" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="0.65"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0.35"/>
        <GradientStop Color="#99000000" Offset="0.8"/>
        <GradientStop Color="#E6000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- ======================= Typography ======================= -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Play triangle used on buttons -->
    <Geometry x:Key="PlayGeometry">M 1,0.6 C 1,0.1 1.5,-0.15 1.95,0.1 L 11.3,5.6 C 11.75,5.85 11.75,6.55 11.3,6.8 L 1.95,12.3 C 1.5,12.55 1,12.3 1,11.8 Z</Geometry>

    <!-- ======================= Converters ======================= -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
    <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    <conv:NullToVisibilityConverter x:Key="InvNullToVis" Invert="True"/>
    <conv:CountToVisibilityConverter x:Key="CountToVis"/>
    <conv:CountToVisibilityConverter x:Key="InvCountToVis" Invert="True"/>
    <conv:EqualsToBoolConverter x:Key="EqualsToBool"/>
    <conv:EqualsToVisibilityConverter x:Key="EqualsToVis"/>
    <conv:EqualsToVisibilityConverter x:Key="InvEqualsToVis" Invert="True"/>
    <conv:CountToBadgeConverter x:Key="CountToBadge"/>
    <conv:NameToBrushConverter x:Key="NameToBrush"/>
    <conv:InitialsConverter x:Key="Initials"/>
    <c:GapToMarginConverter x:Key="GapToMargin"/>
    <conv:SameMultiConverter x:Key="SameMulti"/>
    <conv:EqualsMultiConverter x:Key="EqualsMulti"/>
    <conv:CountToBoolConverter x:Key="CountToBool"/>
    <conv:AtLeastConverter x:Key="AtLeast"/>
    <conv:InvertBoolConverter x:Key="InvertBool"/>
    <conv:RatioToLengthConverter x:Key="RatioToLength"/>
    <conv:HexToBrushConverter x:Key="HexToBrush"/>
    <conv:HexToGlowConverter x:Key="HexToGlow"/>

    <!-- ======================= Text styles ======================= -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style x:Key="Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Margin" Value="2,0,0,7"/>
    </Style>

    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>

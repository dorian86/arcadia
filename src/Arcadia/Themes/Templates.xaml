    <!-- ======================= Toast ======================= -->
    <DataTemplate x:Key="ToastTemplate" DataType="{x:Type vm:ToastMessage}">
        <Grid x:Name="Card" Margin="0,10,0,0" HorizontalAlignment="Right" Opacity="0">
            <Grid.RenderTransform><TranslateTransform X="28"/></Grid.RenderTransform>
            <Border Background="{DynamicResource PanelShadowBrush}" Margin="-34,-26,-34,-40" Opacity="0.55" IsHitTestVisible="False"/>
            <Border CornerRadius="12" Background="{StaticResource Surface2}" BorderBrush="{StaticResource StrokeStrong}"
                    BorderThickness="1" Padding="14,12,18,12" MinWidth="300" MaxWidth="460">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconBg" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
                        <TextBlock x:Name="Icon" Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource Accent}"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Margin="12,5,0,0"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0" FontSize="12.5" Margin="14,0,0,0"
                            Content="{Binding ActionText}" Command="{Binding ActionCommand}" VerticalAlignment="Center"
                            Visibility="{Binding ActionText, Converter={StaticResource NullToVis}}"/>
                </Grid>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Success">
                <Setter TargetName="IconBg" Property="Background" Value="#263DDC97"/>
                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Success}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Warning">
                <Setter TargetName="IconBg" Property="Background" Value="{StaticResource WarningSoft}"/>
                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Warning}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Error">
                <Setter TargetName="IconBg" Property="Background" Value="{StaticResource DangerSoft}"/>
                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Danger}"/>
            </DataTrigger>
            <EventTrigger RoutedEvent="Loaded" SourceName="Card">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.35" EasingFunction="{StaticResource PopEase}"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>

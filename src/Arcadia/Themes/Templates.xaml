<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Arcadia.Controls"
                    xmlns:m="clr-namespace:Arcadia.Models"
                    xmlns:vm="clr-namespace:Arcadia.ViewModels"
                    xmlns:v="clr-namespace:Arcadia.Views"
                    xmlns:sh="clr-namespace:Arcadia.Views.Shells">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Arcadia;component/Themes/Controls.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <BackEase x:Key="PopEase" EasingMode="EaseOut" Amplitude="0.45"/>

    <!-- ======================= Game context menu (created on demand) ======================= -->
    <ContextMenu x:Key="GameContextMenu" x:Shared="False">
        <MenuItem Header="Jouer" FontWeight="SemiBold"
                  Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=PlayCommand}" CommandParameter="{Binding}">
            <MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="13"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Voir la fiche du jeu"
                  Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OpenDetailCommand}" CommandParameter="{Binding}">
            <MenuItem.Icon><TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="13"/></MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ToggleFavoriteCommand}" CommandParameter="{Binding}">
            <MenuItem.Style>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Header" Value="Ajouter aux favoris"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                            <Setter Property="Header" Value="Retirer des favoris"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </MenuItem.Style>
            <MenuItem.Icon><TextBlock Text="&#xEB51;" Style="{StaticResource Glyph}" FontSize="13"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Collections…"
                  Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ManageCollectionsCommand}" CommandParameter="{Binding}">
            <MenuItem.Icon><TextBlock Text="&#xE8EC;" Style="{StaticResource Glyph}" FontSize="13"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Sélectionner"
                  Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ToggleSelectCommand}" CommandParameter="{Binding}">
            <MenuItem.Icon><TextBlock Text="&#xE73A;" Style="{StaticResource Glyph}" FontSize="13"/></MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Header="Modifier…"
                  Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=EditCommand}" CommandParameter="{Binding}">
            <MenuItem.Icon><TextBlock Text="&#xE70F;" Style="{StaticResource Glyph}" FontSize="13"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Changer la jaquette…"
                  Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=SearchCoverCommand}" CommandParameter="{Binding}">
            <MenuItem.Icon><TextBlock Text="&#xEB9F;" Style="{StaticResource Glyph}" FontSize="13"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Réidentifier automatiquement"
                  Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=RefreshMetadataCommand}" CommandParameter="{Binding}">
            <MenuItem.Icon><TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="13"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Ouvrir l'emplacement du fichier" IsEnabled="{Binding CanOpenLocation}"
                  Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OpenLocationCommand}" CommandParameter="{Binding}">
            <MenuItem.Icon><TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" FontSize="13"/></MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ToggleHiddenCommand}" CommandParameter="{Binding}">
            <MenuItem.Style>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Header" Value="Masquer"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                            <Setter Property="Header" Value="Ne plus masquer"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </MenuItem.Style>
            <MenuItem.Icon><TextBlock Text="&#xED1A;" Style="{StaticResource Glyph}" FontSize="13"/></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Retirer de la bibliothèque" Style="{StaticResource DangerMenuItem}"
                  Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=RemoveCommand}" CommandParameter="{Binding}">
            <MenuItem.Icon><TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{StaticResource Danger}"/></MenuItem.Icon>
        </MenuItem>
    </ContextMenu>

    <!-- ======================= Card buttons ======================= -->
    <Style x:Key="CardPlayButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Width" Value="60"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="ToolTip" Value="Jouer"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Ellipse Fill="{DynamicResource AccentGlow}" Margin="-22"/>
                        <Ellipse Fill="{DynamicResource AccentGradient}"/>
                        <Ellipse Stroke="#55FFFFFF" StrokeThickness="1"/>
                        <Path Data="{StaticResource PlayGeometry}" Fill="White" Width="18" Height="20" Stretch="Uniform" Margin="5,0,0,0"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="1.1" ScaleY="1.1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardFavButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Bg" Fill="#990A0C11" Stroke="#33FFFFFF" StrokeThickness="1"/>
                        <TextBlock x:Name="Heart" Text="&#xEB51;" Style="{StaticResource Glyph}" FontSize="14" Foreground="White"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                            <Setter TargetName="Heart" Property="Text" Value="&#xEB52;"/>
                            <Setter TargetName="Heart" Property="Foreground" Value="{StaticResource Favorite}"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="#E60A0C11"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================= Game card ======================= -->
    <Style x:Key="GameCardButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="c:HoverZoom.IsEnabled" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel Background="Transparent">
                        <Grid x:Name="CoverHost" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                            <c:AspectRatioBox Ratio="1.5">
                                <Grid>
                                    <!-- Pre-rendered soft shadow (no live blur) -->
                                    <Border x:Name="Shadow" Background="{DynamicResource CardShadowBrush}"
                                           Margin="-36,-26,-36,-46" Opacity="0.45" IsHitTestVisible="False"/>

                                    <!-- Placeholder when there is no artwork -->
                                    <Border x:Name="Placeholder" CornerRadius="12" Background="{Binding Name, Converter={StaticResource NameToBrush}}">
                                        <Grid>
                                            <Border CornerRadius="12" Background="{StaticResource CardShade}" Opacity="0.65"/>
                                            <TextBlock x:Name="Initials" Text="{Binding Name, Converter={StaticResource Initials}}"
                                                       FontFamily="{StaticResource DisplayFont}" FontSize="46" FontWeight="Bold"
                                                       Foreground="#22FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,46"/>
                                            <Image x:Name="Icon" Width="68" Height="68" Margin="0,0,0,46" VerticalAlignment="Center"
                                                   c:ImageLoader.Source="{Binding IconFullPath}" c:ImageLoader.DecodeWidth="80"/>
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="#F2FFFFFF" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       MaxHeight="64" VerticalAlignment="Bottom" Margin="14,0,14,22"/>
                                        </Grid>
                                    </Border>

                                    <!-- Cover: rounded rectangle painted with the image (no clipping) -->
                                    <Border x:Name="Cover" CornerRadius="12" c:ImageLoader.Source="{Binding CoverFullPath}" c:ImageLoader.DecodeWidth="340"/>

                                    <Border x:Name="Shade" CornerRadius="12" Background="{StaticResource CardShade}" Opacity="0"/>

                                    <Border x:Name="Shine" CornerRadius="12" Opacity="0" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <LinearGradientBrush.RelativeTransform>
                                                    <TranslateTransform X="-1"/>
                                                </LinearGradientBrush.RelativeTransform>
                                                <GradientStop Color="#00FFFFFF" Offset="0.32"/>
                                                <GradientStop Color="#38FFFFFF" Offset="0.5"/>
                                                <GradientStop Color="#00FFFFFF" Offset="0.68"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- Missing file -->
                                    <Border CornerRadius="12" Background="#A6080A0E" Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}">
                                        <Border CornerRadius="8" Background="#E61A1F2B" BorderBrush="#66FFB547" BorderThickness="1"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{StaticResource Warning}"/>
                                                <TextBlock Text="Introuvable" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Warning}" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Border>

                                    <!-- Badges -->
                                    <Border x:Name="NewBadge" CornerRadius="7" Background="{DynamicResource AccentGradient}" Padding="8,3"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                                            Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="NOUVEAU" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <Border CornerRadius="7" Background="#E6141822" BorderBrush="#663DDC97" BorderThickness="1" Padding="8,3"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource Success}" VerticalAlignment="Center"/>
                                            <TextBlock Text="En cours" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Success}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="StatusBadge" CornerRadius="7" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                                            Background="#E6141822" BorderThickness="1" BorderBrush="#40FFFFFF"
                                            Visibility="{Binding HasStatusBadge, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="StatusIcon" Text="{Binding StatusGlyph}" Style="{StaticResource Glyph}" FontSize="9.5" Foreground="White"/>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="White" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <c:Spinner HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Width="16" Height="16"
                                               Visibility="{Binding IsFetching, Converter={StaticResource BoolToVis}}"/>
                                    <Border x:Name="FavMark" Width="26" Height="26" CornerRadius="13" Background="#B30A0C11"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                                            Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xEB52;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{StaticResource Favorite}"/>
                                    </Border>

                                    <!-- Hover ring + actions (not created until hovered) -->
                                    <Border x:Name="Hairline" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource HairlineLight}"/>
                                    <Border x:Name="AccentRing" CornerRadius="13" BorderThickness="2" Margin="-1" Opacity="0"
                                            BorderBrush="{DynamicResource AccentGradient}" IsHitTestVisible="False"/>
                                    <Button x:Name="PlayBtn" Style="{StaticResource CardPlayButton}" Opacity="0" Visibility="Collapsed"
                                            RenderTransformOrigin="0.5,0.5"
                                            Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=PlayCommand}" CommandParameter="{Binding}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button.RenderTransform><ScaleTransform/></Button.RenderTransform>
                                    </Button>
                                    <Button x:Name="FavBtn" Style="{StaticResource CardFavButton}" Opacity="0" Visibility="Collapsed"
                                            Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ToggleFavoriteCommand}" CommandParameter="{Binding}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" ToolTip="Favori"/>

                                    <!-- Selection -->
                                    <Border CornerRadius="14" BorderThickness="3" Margin="-3" BorderBrush="{DynamicResource AccentGradient}"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False"/>
                                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentGradient}" Margin="9"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="13" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </c:AspectRatioBox>
                        </Grid>
                        <TextBlock x:Name="Title" Text="{Binding Name}" Margin="3,12,3,0" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CardSubtitle}" Margin="3,2,3,0" FontSize="12" Foreground="{StaticResource TextMuted}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding CardSubtitle, Converter={StaticResource NullToVis}}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="Cover" Property="c:ImageLoader.IsLoaded" Value="True">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger SourceName="Icon" Property="c:ImageLoader.IsLoaded" Value="True">
                            <Setter TargetName="Initials" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                            <Setter TargetName="NewBadge" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="NewBadge" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="StatusBadge" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Finished">
                            <Setter TargetName="StatusBadge" Property="Background" Value="#E61F7A55"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PlayBtn" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="FavBtn" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="FavMark" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CoverHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.25" EasingFunction="{StaticResource EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="CoverHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.25" EasingFunction="{StaticResource EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="Shade" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.25"/>
                                        <DoubleAnimation Storyboard.TargetName="AccentRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" From="1" To="1" Duration="0:0:0"/>
                                        <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(TranslateTransform.X)" From="-1" To="1" Duration="0:0:0.8" EasingFunction="{StaticResource EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="PlayBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="PlayBtn" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.6" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource PopEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="PlayBtn" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.6" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource PopEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="FavBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CoverHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="CoverHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource EaseOut}"/>
                                        <DoubleAnimation Storyboard.TargetName="Shade" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                        <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="AccentRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="PlayBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="FavBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="GameCardTemplate" DataType="{x:Type m:Game}">
        <Button Style="{StaticResource GameCardButton}" c:GameMenu.Enable="True"
                Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=CardClickCommand}" CommandParameter="{Binding}"/>
    </DataTemplate>

    <!-- ======================= Virtualised grid ======================= -->
    <Style TargetType="c:GameGrid">
        <!-- Top padding leaves room for the hover zoom of the largest card size (280 px → 11 px overflow) -->
        <Setter Property="Padding" Value="40,18,40,110"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ItemTemplate" Value="{StaticResource GameCardTemplate}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:GameGrid">
                    <ItemsControl x:Name="PART_Rows" Focusable="False"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  VirtualizingPanel.CacheLengthUnit="Item"
                                  VirtualizingPanel.CacheLength="2,3"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer c:SmoothScroll.IsEnabled="True" CanContentScroll="True" Focusable="False"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <!-- The hovered row is drawn above its neighbours so the enlarged card is never covered -->
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Panel.ZIndex" Value="1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type c:GameRow}">
                                <ItemsControl ItemsSource="{Binding Items}" Margin="{Binding Margin}" Focusable="False"
                                              ItemTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType=c:GameGrid}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="{Binding Columns}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Margin" Value="{Binding Gap, RelativeSource={RelativeSource AncestorType=c:GameGrid}, Converter={StaticResource GapToMargin}}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Panel.ZIndex" Value="1"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================= Sidebar entry (dynamic lists) ======================= -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Height="40" CornerRadius="10" Background="Transparent" Margin="0,1">
                        <Grid>
                            <Border x:Name="Bar" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentGradient}" Opacity="0"/>
                            <Grid Margin="14,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding c:Ui.Glyph}" Style="{StaticResource Glyph}" FontSize="15"
                                           HorizontalAlignment="Left" Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <Border x:Name="Badge" Grid.Column="2" CornerRadius="9" Padding="8,2" MinWidth="26" VerticalAlignment="Center"
                                        Background="{StaticResource Surface2}">
                                    <TextBlock Text="{TemplateBinding Tag}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="c:Ui.IsActive" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2}"/>
                            <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource Surface3}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================= Progress pills & stars ======================= -->
    <Style x:Key="StatusPill" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#D9FFFFFF"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="18" Background="#1FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"/>
                        <Border x:Name="On" CornerRadius="18" Background="{DynamicResource AccentGradient}" Opacity="0"/>
                        <StackPanel Orientation="Horizontal" Margin="14,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding c:Ui.Glyph}" Style="{StaticResource Glyph}" FontSize="12" Margin="0,1,8,0"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                        <Trigger Property="c:Ui.IsActive" Value="True">
                            <Setter TargetName="On" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StarButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <TextBlock x:Name="Star" Text="&#xE734;" Style="{StaticResource Glyph}" FontSize="20" Foreground="#80FFFFFF"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ui.IsActive" Value="True">
                            <Setter TargetName="Star" Property="Text" Value="&#xE735;"/>
                            <Setter TargetName="Star" Property="Foreground" Value="#FFC94D"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="1.18" ScaleY="1.18"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


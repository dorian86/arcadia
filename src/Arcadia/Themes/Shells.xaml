<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Button with no chrome at all: the theme draws everything inside -->
    <Style x:Key="BareButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <!-- buttons near the top of a theme sit in the window's drag zone: keep them clickable -->
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- On-screen hint ("Ⓑ Retour", "◀ ▶"…) that can also be clicked: subtle pill on hover -->
    <Style x:Key="HintButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="16" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#26808080"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fine horizontal lines of the Wii-style background -->
    <DrawingBrush x:Key="ScanlineBrush" TileMode="Tile" Viewport="0,0,8,6" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 H8 V6 H0 Z"/>
                <GeometryDrawing Brush="#0F5A6470" Geometry="M0,0 H8 V1.2 H0 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Diagonal hatching of an empty channel slot -->
    <DrawingBrush x:Key="EmptySlotBrush" TileMode="Tile" Viewport="0,0,14,14" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFE9ECEF" Geometry="M0,0 H14 V14 H0 Z"/>
                <GeometryDrawing Brush="#FFDDE1E5" Geometry="M0,14 L14,0 L14,4 L4,14 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Light dot grid of the Wii U-style background -->
    <DrawingBrush x:Key="DotGridBrush" TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00FFFFFF" Geometry="M0,0 H26 V26 H0 Z"/>
                <GeometryDrawing Brush="#14707A86">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="13,13" RadiusX="1.6" RadiusY="1.6"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
